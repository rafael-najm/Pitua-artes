---
import { u } from '../lib/url';
import { site, linkWhatsapp } from '../data/site';

const ano = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr-top">
      <div class="ftr-brand">
        <p class="ftr-name">{site.nome}</p>
        <p class="ftr-tag">Um universo de cores feitas à mão.</p>
      </div>

      <nav class="ftr-col" aria-label="Rodapé">
        <p class="eyebrow">Navegar</p>
        <a href={u('/acervo/')}>Acervo</a>
        <a href={u('/oficinas/')}>Oficinas</a>
        <a href={u('/encomendas/')}>Encomendas</a>
      </nav>

      <div class="ftr-col">
        <p class="eyebrow">Contato</p>
        <a href={linkWhatsapp('Olá! Vim pelo site da Pitua.')} target="_blank" rel="noopener">WhatsApp</a>
        {
          site.instagram && (
            <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">
              Instagram
            </a>
          )
        }
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      </div>

      <div class="ftr-col ftr-cta">
        <p class="eyebrow status">Encomendas abertas</p>
        <p class="ftr-cta-txt">Uma peça criada a partir da sua história.</p>
        <a class="link" href={u('/encomendas/')}>Encomendar <span class="arrow">→</span></a>
      </div>
    </div>

    <div class="ftr-bottom">
      <p>© {ano} {site.nome} · {site.assinatura}</p>
      <p>Todas as peças são pintadas à mão, uma a uma.</p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--night);
    color: var(--on-night);
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
  }
  .ftr .eyebrow {
    color: var(--on-night-muted);
    margin-bottom: 0.5rem;
  }
  .ftr-top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: 3rem 2rem;
  }
  .ftr-name {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    line-height: 1;
  }
  .ftr-tag {
    margin-top: 1rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    font-weight: 300;
    color: var(--on-night-muted);
  }
  .ftr-col {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.6rem;
  }
  .ftr-col a:not(.link) {
    color: var(--on-night);
    opacity: 0.85;
    transition: opacity 0.3s;
  }
  .ftr-col a:not(.link):hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .ftr-cta-txt {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 330;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
  .ftr-bottom {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgb(242 238 231 / 0.14);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: 0.8rem;
    color: var(--on-night-muted);
  }
  @media (max-width: 900px) {
    .ftr-top {
      grid-template-columns: 1fr 1fr;
    }
    .ftr-brand,
    .ftr-cta {
      grid-column: 1 / -1;
    }
  }
</style>
