---
import { Image } from 'astro:assets';
import type { PecaPersonalizavel } from '../data/personalizar';
import { formatarPreco } from '../data/personalizar';
import { u } from '../lib/url';
import type { ImageMetadata } from 'astro';

interface Props {
  peca: PecaPersonalizavel & { foto: ImageMetadata };
  sizes?: string;
}
const { peca, sizes = '(max-width: 760px) 50vw, (max-width: 1100px) 33vw, 25vw' } = Astro.props;
---

<a class="pcard" href={u(`/encomendas/${peca.slug}/`)}>
  <div class="pcard-media frame">
    <Image src={peca.foto} alt={peca.alt} widths={[320, 480, 640, 960]} sizes={sizes} class="pcard-img" />
  </div>
  <div class="pcard-meta">
    <h3 class="pcard-name">{peca.nome}</h3>
    <p class="pcard-sum">{peca.resumo}</p>
    <p class="pcard-price"><span>A partir de</span> {formatarPreco(peca.aPartirDe)}</p>
  </div>
</a>

<style>
  .pcard {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .pcard-media {
    aspect-ratio: 1;
  }
  .pcard-media :global(.pcard-img) {
    transition: transform 1.4s var(--ease);
  }
  @media (hover: hover) {
    .pcard:hover :global(.pcard-img) {
      transform: scale(1.04);
    }
  }
  .pcard-meta {
    display: grid;
    gap: 0.3rem;
  }
  .pcard-name {
    font-size: 1.25rem;
    font-weight: 350;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .pcard-sum {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .pcard-price {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    font-weight: 450;
  }
  .pcard-price span {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-right: 0.35rem;
  }
  @media (max-width: 700px) {
    .pcard-name {
      font-size: 1.05rem;
    }
  }
</style>
