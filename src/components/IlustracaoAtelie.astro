---
/**
 * Ilustração decorativa do ateliê: copinho com pincéis, potiche pintado e paleta de tintas.
 * Desenhada em SVG com as cores da marca (ver tokens em global.css).
 */
interface Props {
  class?: string;
}
const { class: classe } = Astro.props;

// Pincéis: ângulo (graus), comprimento, cor do cabo, cor da tinta na ponta, espessura
const pinceis = [
  { x: 148, a: -17, l: 250, cabo: 'var(--azul)', tinta: '#e0679a', s: 1 },
  { x: 163, a: -6, l: 292, cabo: 'var(--creme-escuro)', tinta: 'var(--turquesa)', s: 1.15 },
  { x: 180, a: 5, l: 268, cabo: 'var(--turquesa)', tinta: '#f2c14e', s: 0.95 },
  { x: 194, a: 16, l: 228, cabo: 'var(--creme-escuro)', tinta: 'var(--verde)', s: 0.85 },
];
const pincel = (l: number) => {
  const h = l * 0.66;
  const f = h + 26;
  return {
    cabo: `M-3.6 0 L-5.6 ${-h} L5.6 ${-h} L3.6 0 Z`,
    virola: `M-5.6 ${-h} L-4.9 ${-f} L4.9 ${-f} L5.6 ${-h} Z`,
    friso: `M-5.4 ${-(h + 7)} L5.4 ${-(h + 7)}`,
    cerdas: `M-4.9 ${-f} C-7.6 ${-(f + 14)} -3.2 ${-(f + 34)} 0 ${-(f + 46)} C3.2 ${-(f + 34)} 7.6 ${-(f + 14)} 4.9 ${-f} Z`,
    tinta: `M-6.1 ${-(f + 17)} C-4.4 ${-(f + 30)} -2.2 ${-(f + 39)} 0 ${-(f + 46)} C2.2 ${-(f + 39)} 4.4 ${-(f + 30)} 6.1 ${-(f + 17)} Q0 ${-(f + 21)} -6.1 ${-(f + 17)} Z`,
  };
};
---

<svg
  class:list={['ilustra', classe]}
  viewBox="0 0 600 480"
  role="img"
  aria-label="Ilustração: copinho de porcelana com pincéis, potiche pintado e paleta de tintas"
>
  <g class="tr" fill="none" stroke="var(--azul)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <!-- mancha de fundo, no formato orgânico do esboço -->
    <path
      d="M118 118 C182 46 312 42 404 74 C502 108 578 178 566 282 C556 372 474 446 352 452 C230 458 108 430 62 352 C20 280 56 186 118 118 Z"
      fill="var(--creme)"
      stroke="none"></path>

    <!-- potiche -->
    <g class="potiche">
      <path d="M448 346 L452 360 L490 360 L494 346" fill="var(--porcelana)"></path>
      <path
        d="M440 190 C400 204 394 262 409 302 C420 332 441 348 471 348 C501 348 522 332 533 302 C548 262 542 204 502 190 Z"
        fill="var(--porcelana)"></path>
      <path d="M418 218 C452 226 490 226 524 218" stroke="var(--turquesa)" stroke-width="5" opacity=".85"></path>
      <path d="M433 336 C458 343 486 343 510 336" stroke="var(--azul)" stroke-width="3" opacity=".7"></path>
      <path d="M454 334 C440 300 437 270 446 244 C455 274 461 304 454 334 Z" fill="var(--verde)" stroke="none"></path>
      <path d="M470 338 C478 302 492 282 506 270 C501 302 489 323 470 338 Z" fill="#a8d266" stroke="none"></path>
      <path d="M462 336 C466 300 470 278 478 262" stroke="var(--verde)" stroke-width="1.6"></path>
      <g transform="translate(482 252)" stroke="none">
        <ellipse cx="0" cy="-11" rx="6" ry="10" fill="#e0679a"></ellipse>
        <ellipse cx="0" cy="-11" rx="6" ry="10" fill="#e0679a" transform="rotate(72)"></ellipse>
        <ellipse cx="0" cy="-11" rx="6" ry="10" fill="#e0679a" transform="rotate(144)"></ellipse>
        <ellipse cx="0" cy="-11" rx="6" ry="10" fill="#e0679a" transform="rotate(216)"></ellipse>
        <ellipse cx="0" cy="-11" rx="6" ry="10" fill="#e0679a" transform="rotate(288)"></ellipse>
        <circle r="4.5" fill="#f2c14e"></circle>
      </g>
      <path d="M432 190 C432 172 452 162 471 162 C490 162 510 172 510 190 Z" fill="var(--porcelana)"></path>
      <path d="M440 182 C460 176 482 176 502 182" stroke="var(--turquesa)" stroke-width="2.5" opacity=".85"></path>
      <circle cx="471" cy="154" r="7.5" fill="var(--azul)"></circle>
    </g>

    <!-- copinho com pincéis -->
    <ellipse cx="170" cy="270" rx="62" ry="13" fill="#e7e1d8"></ellipse>
    {
      pinceis.map((p) => {
        const d = pincel(p.l);
        return (
          <g class="pincel" transform={`translate(${p.x} 300) rotate(${p.a}) scale(${p.s})`}>
            <path d={d.cabo} fill={p.cabo} />
            <path d={d.virola} fill="#d6d1c9" />
            <path d={d.friso} stroke-width="1" />
            <path d={d.cerdas} fill="#d9c09a" />
            <path d={d.tinta} fill={p.tinta} stroke="none" />
          </g>
        );
      })
    }
    <path d="M108 270 L116 420 A54 11 0 0 0 224 420 L232 270 A62 13 0 0 1 108 270 Z" fill="var(--porcelana)"></path>
    <path d="M109.4 294 A62 13 0 0 0 230.6 294" stroke="var(--turquesa)" stroke-width="6" opacity=".85"></path>
    <path d="M111.6 308 A62 13 0 0 0 228.4 308" stroke="var(--verde)" stroke-width="2" opacity=".9"></path>
    {
      [
        [140, 352, '#e0679a'],
        [176, 372, 'var(--turquesa)'],
        [205, 344, '#f2c14e'],
      ].map(([x, y, c]) => (
        <g transform={`translate(${x} ${y})`} stroke="none">
          {[0, 72, 144, 216, 288].map((r) => (
            <ellipse cx="0" cy="-5" rx="3" ry="5" fill={c as string} transform={`rotate(${r})`} />
          ))}
          <circle r="2.2" fill="var(--azul)" />
        </g>
      ))
    }

    <!-- paleta com tintas -->
    <ellipse cx="402" cy="400" rx="122" ry="40" fill="var(--porcelana)"></ellipse>
    <ellipse cx="402" cy="398" rx="104" ry="31" stroke-width="1" opacity=".35"></ellipse>
    <g stroke="none">
      <ellipse cx="338" cy="392" rx="16" ry="6" fill="var(--turquesa)"></ellipse>
      <ellipse cx="374" cy="410" rx="16" ry="6" fill="var(--verde)"></ellipse>
      <ellipse cx="416" cy="414" rx="16" ry="6" fill="#e0679a"></ellipse>
      <ellipse cx="456" cy="405" rx="16" ry="6" fill="#f2c14e"></ellipse>
      <ellipse cx="482" cy="388" rx="14" ry="5.5" fill="var(--azul)"></ellipse>
      <ellipse cx="333" cy="390" rx="5" ry="1.6" fill="#fff" opacity=".7"></ellipse>
      <ellipse cx="369" cy="408" rx="5" ry="1.6" fill="#fff" opacity=".7"></ellipse>
      <ellipse cx="411" cy="412" rx="5" ry="1.6" fill="#fff" opacity=".7"></ellipse>
      <ellipse cx="451" cy="403" rx="5" ry="1.6" fill="#fff" opacity=".7"></ellipse>
    </g>
    <path d="M392 384 C404 376 420 378 430 386" stroke="var(--turquesa)" stroke-width="3" opacity=".8"></path>

    <!-- respingos -->
    <g stroke="none" class="respingos">
      <circle cx="292" cy="118" r="5" fill="var(--turquesa)"></circle>
      <circle cx="310" cy="102" r="2.6" fill="var(--verde)"></circle>
      <circle cx="268" cy="96" r="2" fill="#e0679a"></circle>
      <circle cx="552" cy="172" r="4" fill="#f2c14e"></circle>
      <circle cx="540" cy="150" r="2.2" fill="var(--turquesa)"></circle>
      <circle cx="86" cy="214" r="3.4" fill="var(--verde)"></circle>
      <circle cx="72" cy="236" r="1.8" fill="#e0679a"></circle>
    </g>
    <path d="M250 440 C276 428 300 448 326 436 C344 428 356 438 368 432" stroke="var(--verde)" stroke-width="2" opacity=".8"></path>
  </g>
</svg>

<style>
  .ilustra {
    --porcelana: #fcfbf9;
    --creme-escuro: #e9d5b5;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .pincel {
    transform-box: view-box;
  }
  @media (prefers-reduced-motion: no-preference) {
    .respingos circle {
      animation: flutua 6s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    .respingos circle:nth-child(2n) {
      animation-delay: -2s;
    }
    .respingos circle:nth-child(3n) {
      animation-delay: -4s;
    }
    @keyframes flutua {
      50% {
        transform: translateY(-6px);
      }
    }
  }
</style>
