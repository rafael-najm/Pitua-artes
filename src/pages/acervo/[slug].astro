---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PecaCard from '../../components/PecaCard.astro';
import { pecas, categorias, type Peca } from '../../data/pecas';
import { fotosDa } from '../../lib/fotos';
import { u } from '../../lib/url';

export function getStaticPaths() {
  return pecas.map((peca) => ({ params: { slug: peca.slug }, props: { peca } }));
}

interface Props {
  peca: Peca;
}
const { peca } = Astro.props;
const fotos = fotosDa(peca.slug);

const mesmas = pecas.filter((p) => p.categoria === peca.categoria && p.slug !== peca.slug);
const outras = pecas.filter((p) => p.categoria !== peca.categoria && p.destaque && p.slug !== peca.slug);
const relacionadas = [...mesmas, ...outras].slice(0, 4);

const idx = pecas.findIndex((p) => p.slug === peca.slug);
const anterior = pecas[(idx - 1 + pecas.length) % pecas.length];
const proxima = pecas[(idx + 1) % pecas.length];


const largura = (f: ImageMetadata) => (f.width > f.height * 1.15 ? 'wide' : 'tall');
---

<Base titulo={peca.nome} descricao={`${peca.nome} — ${peca.resumo} Porcelana pintada à mão pela Pituá.`} imagem={fotos[0]}>
  <nav class="crumbs wrap" aria-label="Você está em">
    <a href={u('/acervo/')}>Acervo</a>
    <span aria-hidden="true">/</span>
    <a href={u(`/acervo/?categoria=${peca.categoria}`)}>{categorias[peca.categoria]}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{peca.nome}</span>
  </nav>

  <article class="pdp wrap">
    <div class="galeria-wrap">
    <div class="galeria" data-galeria>
      {
        fotos.map((f, i) => (
          <button
            type="button"
            class:list={['g-item frame', largura(f)]}
            data-zoom={i}
            aria-label={`Ampliar foto ${i + 1} de ${fotos.length}`}
          >
            <Image
              src={f}
              alt={i === 0 ? peca.nome : `${peca.nome} — foto ${i + 1}`}
              widths={[480, 720, 960, 1280, 1600]}
              sizes={largura(f) === 'wide' || i === 0 ? '(max-width: 900px) 88vw, 58vw' : '(max-width: 900px) 88vw, 29vw'}
              loading={i < 2 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </button>
        ))
      }
      {
        peca.video && (
          <div class="g-item tall frame g-video">
            <video data-loop muted loop playsinline preload="none" poster={u(`/video/${peca.video}.jpg`)} aria-label={`Vídeo: ${peca.nome} em uso`}>
              <source src={u(`/video/${peca.video}.mp4`)} type="video/mp4" />
            </video>
          </div>
        )
      }
    </div>
    <button type="button" class="g-seta g-prev" data-g-prev aria-label="Foto anterior">←</button>
    <button type="button" class="g-seta g-next" data-g-next aria-label="Próxima foto">→</button>
    <p class="g-count" aria-hidden="true"><span data-g-atual>1</span> / {fotos.length + (peca.video ? 1 : 0)}</p>
    <div class="g-thumbs" aria-label="Escolher foto">
      {
        fotos.map((f, i) => (
          <button type="button" class:list={['g-thumb frame', { on: i === 0 }]} data-g-ir={i} aria-label={`Ver foto ${i + 1}`}>
            <Image src={f} alt="" widths={[120, 200]} sizes="80px" loading="lazy" />
          </button>
        ))
      }
    </div>
    </div>

    <aside class="info">
      <div class="info-in">
        <p class="eyebrow">{categorias[peca.categoria]}</p>
        <h1 class="info-nome">{peca.nome}</h1>
        <p class="info-resumo">{peca.resumo}</p>

        <ul class="info-tags">
          <li>Peça do acervo</li>
          <li>Pintada à mão</li>
          {peca.encomenda && <li>Projeto sob encomenda</li>}
        </ul>

        <div class="info-acoes">
          <a class="btn btn--block" href={u(`/encomendas/?peca=${peca.slug}#formulario`)}>Encomendar uma peça inspirada</a>
          <p class="info-nota">Esta peça faz parte do acervo e não está à venda. Ela pode inspirar uma nova, pintada só para você.</p>
        </div>

        <div class="info-desc">
          {peca.descricao.map((p) => <p>{p}</p>)}
        </div>

        <div class="info-acc">
          <details class="acc">
            <summary>Detalhes</summary>
            <div class="acc-body">
              <dl class="dl">
                <dt>Técnica</dt><dd>Pintura à mão</dd>
                <dt>Exemplar</dt><dd>Único — nenhuma peça se repete</dd>
                <dt>Acervo</dt><dd>Peça da artista, não está à venda</dd>
              </dl>
            </div>
          </details>
          <details class="acc">
            <summary>Cuidados</summary>
            <div class="acc-body">
              <p>Para preservar a pintura por muitos anos, prefira lavar à mão, com esponja macia e detergente neutro.</p>
              <p>Peças com detalhes em ouro não devem ir ao micro-ondas.</p>
            </div>
          </details>
          <details class="acc">
            <summary>Encomendas</summary>
            <div class="acc-body">
              <p>
                Gostou desta peça? Ela não está à venda, mas pode inspirar uma nova, feita sob encomenda — com as suas cores, nomes ou detalhes. Como
                tudo é pintado à mão, a nova peça terá a sua própria personalidade.
              </p>
            </div>
          </details>
        </div>
      </div>
    </aside>
  </article>

  <nav class="vizinhas wrap" aria-label="Outras peças">
    <a href={u(`/acervo/${anterior.slug}/`)} rel="prev"><span class="eyebrow">← Anterior</span><span class="viz-nome">{anterior.nome}</span></a>
    <a href={u(`/acervo/${proxima.slug}/`)} rel="next"><span class="eyebrow">Próxima →</span><span class="viz-nome">{proxima.nome}</span></a>
  </nav>

  <section class="rel wrap" aria-labelledby="rel-titulo">
    <h2 id="rel-titulo" class="h3">Mais do acervo</h2>
    <div class="rel-grid">
      {relacionadas.map((p) => <PecaCard peca={p} />)}
    </div>
  </section>

  <dialog class="lb" data-lb aria-label={`Fotos — ${peca.nome}`}>
    <div class="lb-track" data-lb-track>
      {
        fotos.map((f, i) => (
          <figure class="lb-slide">
            <Image src={f} alt={i === 0 ? peca.nome : `${peca.nome} — foto ${i + 1}`} widths={[960, 1600, 2000]} sizes="100vw" loading="lazy" />
          </figure>
        ))
      }
    </div>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Fechar">×</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Foto anterior">←</button>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Próxima foto">→</button>
    <p class="lb-count"><span data-lb-atual>1</span> / {fotos.length}</p>
  </dialog>
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-block: 1.5rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .crumbs [aria-current] {
    color: var(--ink);
  }

  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 2.88vw, 3.5rem);
    align-items: start;
    padding-bottom: clamp(2.75rem, 4.8vw, 4.25rem);
  }

  /* Galeria: uma foto por vez, com setas */
  .galeria-wrap {
    position: relative;
  }
  .galeria {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .galeria::-webkit-scrollbar {
    display: none;
  }
  .g-item,
  .g-item.wide,
  .g-item:first-child.tall {
    flex: 0 0 100%;
    aspect-ratio: 4 / 5;
    scroll-snap-align: start;
    border: 0;
    padding: 0;
    cursor: zoom-in;
  }
  .g-video {
    cursor: default;
  }
  .g-seta {
    position: absolute;
    top: calc((100% - var(--thumbs-h, 0px)) / 2);
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: color-mix(in srgb, var(--porcelain) 88%, transparent);
    box-shadow: 0 4px 18px rgb(38 55 70 / 0.12);
    color: var(--brand);
    font-size: 1.15rem;
    cursor: pointer;
    z-index: 2;
    transition: background 0.3s, opacity 0.3s;
  }
  .g-seta:hover {
    background: var(--porcelain);
  }
  .g-seta:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .g-prev {
    left: 1rem;
  }
  .g-next {
    right: 1rem;
  }
  .g-count {
    position: absolute;
    left: 1rem;
    top: 1rem;
    margin: 0;
    background: color-mix(in srgb, var(--porcelain) 88%, transparent);
    padding: 0.3rem 0.65rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    pointer-events: none;
    z-index: 2;
  }
  .g-thumbs {
    --thumbs-h: 0px;
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .g-thumb {
    flex: 0 0 72px;
    aspect-ratio: 4 / 5;
    border: 1px solid transparent;
    padding: 0;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.3s, border-color 0.3s;
  }
  .g-thumb.on,
  .g-thumb:hover {
    opacity: 1;
    border-color: var(--accent);
  }
  .galeria-wrap:has(.g-thumbs) .g-seta {
    top: calc(50% - 44px);
  }

  /* Painel */
  .info {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .info-in {
    display: grid;
    gap: 1.4rem;
  }
  .info-nome {
    font-size: clamp(2.2rem, 3.2vw, 3rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .info-resumo {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
    font-weight: 300;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .info-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .info-tags li {
    border: 1px solid var(--line-strong);
    padding: 0.35rem 0.75rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .info-acoes {
    display: grid;
    gap: 0.75rem;
    margin-block: 0.5rem;
  }
  .info-nota {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
  }
  .info-desc {
    display: grid;
    gap: 0.9rem;
    color: var(--ink-2);
    font-size: 1.02rem;
  }
  .info-acc {
    margin-top: 0.5rem;
  }
  .dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem 1.5rem;
    margin: 0;
  }
  .dl dt {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .dl dd {
    margin: 0;
  }

  /* Vizinhas */
  .vizinhas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
  }
  .vizinhas a {
    display: grid;
    gap: 0.5rem;
    padding-block: 2rem;
  }
  .vizinhas a[rel='next'] {
    text-align: right;
    border-left: 1px solid var(--line);
  }
  .viz-nome {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 300;
    line-height: 1.2;
    transition: opacity 0.3s;
  }
  .vizinhas a:hover .viz-nome {
    opacity: 0.6;
  }

  /* Relacionadas */
  .rel {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 4.2vw, 3.5rem) clamp(3.5rem, 5.4vw, 4.75rem);
  }
  .rel h2 {
    margin-bottom: 2.5rem;
  }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem clamp(1rem, 2vw, 1.75rem);
  }

  /* Lightbox */
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--porcelain);
    color: var(--ink);
  }
  .lb::backdrop {
    background: var(--porcelain);
  }
  .lb-track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .lb-track::-webkit-scrollbar {
    display: none;
  }
  .lb-slide {
    flex: 0 0 100%;
    height: 100%;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    scroll-snap-align: center;
    display: grid;
    place-items: center;
  }
  .lb-slide :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lb-btn {
    position: fixed;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--porcelain) 80%, transparent);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.3s, color 0.3s;
  }
  .lb-btn:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
    font-size: 1.6rem;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 1rem;
  }
  .lb-next {
    right: 1rem;
  }
  .lb-count {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
  }

  @media (max-width: 1100px) {
    .rel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .crumbs {
      padding-block: 1rem;
    }
    .crumbs [aria-current],
    .crumbs span:nth-last-child(2) {
      display: none;
    }
    .pdp {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .g-thumbs {
      display: none;
    }
    .galeria-wrap .g-seta {
      top: 50%;
      width: 42px;
      height: 42px;
    }
    .galeria {
      margin-inline: calc(var(--gutter) * -1);
    }
    .g-prev {
      left: 0.25rem;
    }
    .g-next {
      right: 0.25rem;
    }
    .g-count {
      left: 0;
    }
    .info {
      position: static;
    }
    .lb-prev,
    .lb-next {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .vizinhas {
      grid-template-columns: 1fr;
    }
    .vizinhas a[rel='next'] {
      border-left: 0;
      border-top: 1px solid var(--line);
      text-align: left;
    }
  }
</style>

<script>
  const galeria = document.querySelector<HTMLElement>('[data-galeria]');
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]');
  const track = document.querySelector<HTMLElement>('[data-lb-track]');
  const atualLb = document.querySelector<HTMLElement>('[data-lb-atual]');
  const atualG = document.querySelector<HTMLElement>('[data-g-atual]');

  const irPara = (i: number, suave = true) => {
    if (!track) return;
    const n = track.children.length;
    const alvo = (i + n) % n;
    track.scrollTo({ left: alvo * track.clientWidth, behavior: suave ? 'smooth' : 'instant' });
  };
  const indiceAtual = () => (track ? Math.round(track.scrollLeft / track.clientWidth) : 0);

  galeria?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-zoom]');
    if (!b || !lb) return;
    // No celular a galeria já é um carrossel; o zoom abre em tela cheia do mesmo jeito.
    lb.showModal();
    requestAnimationFrame(() => irPara(Number(b.dataset.zoom), false));
  });

  track?.addEventListener(
    'scroll',
    () => {
      if (atualLb) atualLb.textContent = String(indiceAtual() + 1);
    },
    { passive: true },
  );
  document.querySelector('[data-lb-close]')?.addEventListener('click', () => lb?.close());
  document.querySelector('[data-lb-prev]')?.addEventListener('click', () => irPara(indiceAtual() - 1));
  document.querySelector('[data-lb-next]')?.addEventListener('click', () => irPara(indiceAtual() + 1));
  lb?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') irPara(indiceAtual() + 1);
    if (e.key === 'ArrowLeft') irPara(indiceAtual() - 1);
  });
  lb?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).classList.contains('lb-slide')) lb.close();
  });

  // Carrossel da galeria: setas, contador e miniaturas
  const itensG = galeria ? [...galeria.querySelectorAll<HTMLElement>('.g-item')] : [];
  const prevG = document.querySelector<HTMLButtonElement>('[data-g-prev]');
  const nextG = document.querySelector<HTMLButtonElement>('[data-g-next]');
  const thumbs = [...document.querySelectorAll<HTMLElement>('[data-g-ir]')];
  const atualIdx = () => (galeria ? Math.round(galeria.scrollLeft / galeria.clientWidth) : 0);
  const irG = (i: number) => {
    if (!galeria) return;
    const alvo = Math.max(0, Math.min(itensG.length - 1, i));
    galeria.scrollTo({ left: alvo * galeria.clientWidth, behavior: 'smooth' });
  };
  const marcaG = () => {
    const i = atualIdx();
    if (atualG) atualG.textContent = String(i + 1);
    if (prevG) prevG.disabled = i === 0;
    if (nextG) nextG.disabled = i >= itensG.length - 1;
    thumbs.forEach((t) => t.classList.toggle('on', Number(t.dataset.gIr) === i));
  };
  prevG?.addEventListener('click', () => irG(atualIdx() - 1));
  nextG?.addEventListener('click', () => irG(atualIdx() + 1));
  thumbs.forEach((t) => t.addEventListener('click', () => irG(Number(t.dataset.gIr))));
  galeria?.addEventListener('scroll', marcaG, { passive: true });
  document.addEventListener('keydown', (e) => {
    if (lb?.open) return;
    if (e.key === 'ArrowRight') irG(atualIdx() + 1);
    if (e.key === 'ArrowLeft') irG(atualIdx() - 1);
  });
  marcaG();
</script>
