---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PecaCard from '../../components/PecaCard.astro';
import { pecas, categorias, type Peca } from '../../data/pecas';
import { fotosDa } from '../../lib/fotos';
import { linkWhatsapp } from '../../data/site';
import { u } from '../../lib/url';

export function getStaticPaths() {
  return pecas.map((peca) => ({ params: { slug: peca.slug }, props: { peca } }));
}

interface Props {
  peca: Peca;
}
const { peca } = Astro.props;
const fotos = fotosDa(peca.slug);
const urlPeca = new URL(Astro.url.pathname, Astro.site).toString();

const mesmas = pecas.filter((p) => p.categoria === peca.categoria && p.slug !== peca.slug);
const outras = pecas.filter((p) => p.categoria !== peca.categoria && p.destaque && p.slug !== peca.slug);
const relacionadas = [...mesmas, ...outras].slice(0, 4);

const idx = pecas.findIndex((p) => p.slug === peca.slug);
const anterior = pecas[(idx - 1 + pecas.length) % pecas.length];
const proxima = pecas[(idx + 1) % pecas.length];

const msgDisponibilidade = `Olá! Vi a peça "${peca.nome}" no site da Pitua e gostaria de saber sobre a disponibilidade.\n${urlPeca}`;

const largura = (f: ImageMetadata) => (f.width > f.height * 1.15 ? 'wide' : 'tall');
---

<Base titulo={peca.nome} descricao={`${peca.nome} — ${peca.resumo} Porcelana pintada à mão pela Pitua.`} imagem={fotos[0]}>
  <nav class="crumbs wrap" aria-label="Você está em">
    <a href={u('/acervo/')}>Acervo</a>
    <span aria-hidden="true">/</span>
    <a href={u(`/acervo/?categoria=${peca.categoria}`)}>{categorias[peca.categoria]}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{peca.nome}</span>
  </nav>

  <article class="pdp wrap">
    <div class="galeria-wrap">
    <div class="galeria" data-galeria>
      {
        fotos.map((f, i) => (
          <button
            type="button"
            class:list={['g-item frame', largura(f)]}
            data-zoom={i}
            aria-label={`Ampliar foto ${i + 1} de ${fotos.length}`}
          >
            <Image
              src={f}
              alt={i === 0 ? peca.nome : `${peca.nome} — foto ${i + 1}`}
              widths={[480, 720, 960, 1280, 1600]}
              sizes={largura(f) === 'wide' || i === 0 ? '(max-width: 900px) 88vw, 58vw' : '(max-width: 900px) 88vw, 29vw'}
              loading={i < 2 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </button>
        ))
      }
      {
        peca.video && (
          <div class="g-item tall frame g-video">
            <video data-loop muted loop playsinline preload="none" poster={u(`/video/${peca.video}.jpg`)} aria-label={`Vídeo: ${peca.nome} em uso`}>
              <source src={u(`/video/${peca.video}.mp4`)} type="video/mp4" />
            </video>
          </div>
        )
      }
    </div>
    <p class="g-count" aria-hidden="true"><span data-g-atual>1</span> / {fotos.length + (peca.video ? 1 : 0)}</p>
    </div>

    <aside class="info">
      <div class="info-in">
        <p class="eyebrow">{categorias[peca.categoria]}</p>
        <h1 class="info-nome">{peca.nome}</h1>
        <p class="info-resumo">{peca.resumo}</p>

        <ul class="info-tags">
          <li>Peça única</li>
          <li>Pintada à mão</li>
          {peca.encomenda && <li>Projeto sob encomenda</li>}
        </ul>

        <div class="info-acoes">
          <a class="btn btn--block" href={linkWhatsapp(msgDisponibilidade)} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            Consultar disponibilidade
          </a>
          <a class="btn btn--ghost btn--block" href={u(`/encomendas/?peca=${peca.slug}#formulario`)}>Encomendar uma peça inspirada</a>
        </div>

        <div class="info-desc">
          {peca.descricao.map((p) => <p>{p}</p>)}
        </div>

        <div class="info-acc">
          <details class="acc">
            <summary>Detalhes</summary>
            <div class="acc-body">
              <dl class="dl">
                <dt>Técnica</dt><dd>Pintura à mão</dd>
                <dt>Exemplar</dt><dd>Único — nenhuma peça se repete</dd>
                <dt>Medidas</dt><dd>Sob consulta</dd>
                <dt>Valor</dt><dd>Sob consulta</dd>
              </dl>
            </div>
          </details>
          <details class="acc">
            <summary>Cuidados</summary>
            <div class="acc-body">
              <p>Para preservar a pintura por muitos anos, prefira lavar à mão, com esponja macia e detergente neutro.</p>
              <p>Peças com detalhes em ouro não devem ir ao micro-ondas.</p>
            </div>
          </details>
          <details class="acc">
            <summary>Encomendas</summary>
            <div class="acc-body">
              <p>
                Gostou desta peça? É possível encomendar uma nova, inspirada nela — com as suas cores, nomes ou detalhes. Como
                tudo é pintado à mão, a nova peça terá a sua própria personalidade.
              </p>
            </div>
          </details>
        </div>
      </div>
    </aside>
  </article>

  <nav class="vizinhas wrap" aria-label="Outras peças">
    <a href={u(`/acervo/${anterior.slug}/`)} rel="prev"><span class="eyebrow">← Anterior</span><span class="viz-nome">{anterior.nome}</span></a>
    <a href={u(`/acervo/${proxima.slug}/`)} rel="next"><span class="eyebrow">Próxima →</span><span class="viz-nome">{proxima.nome}</span></a>
  </nav>

  <section class="rel wrap" aria-labelledby="rel-titulo">
    <h2 id="rel-titulo" class="h3">Mais do acervo</h2>
    <div class="rel-grid">
      {relacionadas.map((p) => <PecaCard peca={p} />)}
    </div>
  </section>

  <dialog class="lb" data-lb aria-label={`Fotos — ${peca.nome}`}>
    <div class="lb-track" data-lb-track>
      {
        fotos.map((f, i) => (
          <figure class="lb-slide">
            <Image src={f} alt={i === 0 ? peca.nome : `${peca.nome} — foto ${i + 1}`} widths={[960, 1600, 2000]} sizes="100vw" loading="lazy" />
          </figure>
        ))
      }
    </div>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Fechar">×</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Foto anterior">←</button>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Próxima foto">→</button>
    <p class="lb-count"><span data-lb-atual>1</span> / {fotos.length}</p>
  </dialog>
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-block: 1.5rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .crumbs [aria-current] {
    color: var(--ink);
  }

  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* Galeria */
  .galeria {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .g-item {
    border: 0;
    padding: 0;
    cursor: zoom-in;
    aspect-ratio: 4 / 5;
  }
  .g-item.wide {
    grid-column: 1 / -1;
    aspect-ratio: 3 / 2;
  }
  .g-item:first-child.tall {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 5;
  }
  .g-video {
    cursor: default;
    aspect-ratio: 4 / 5;
  }
  .galeria-wrap {
    position: relative;
  }
  .g-count {
    display: none;
  }

  /* Painel */
  .info {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .info-in {
    display: grid;
    gap: 1.4rem;
  }
  .info-nome {
    font-size: clamp(2.2rem, 3.2vw, 3rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .info-resumo {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
    font-weight: 300;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .info-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .info-tags li {
    border: 1px solid var(--line-strong);
    padding: 0.35rem 0.75rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .info-acoes {
    display: grid;
    gap: 0.75rem;
    margin-block: 0.5rem;
  }
  .info-desc {
    display: grid;
    gap: 0.9rem;
    color: var(--ink-2);
    font-size: 1.02rem;
  }
  .info-acc {
    margin-top: 0.5rem;
  }
  .dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem 1.5rem;
    margin: 0;
  }
  .dl dt {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .dl dd {
    margin: 0;
  }

  /* Vizinhas */
  .vizinhas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
  }
  .vizinhas a {
    display: grid;
    gap: 0.5rem;
    padding-block: 2rem;
  }
  .vizinhas a[rel='next'] {
    text-align: right;
    border-left: 1px solid var(--line);
  }
  .viz-nome {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 300;
    line-height: 1.2;
    transition: opacity 0.3s;
  }
  .vizinhas a:hover .viz-nome {
    opacity: 0.6;
  }

  /* Relacionadas */
  .rel {
    border-top: 1px solid var(--line);
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(5rem, 9vw, 8rem);
  }
  .rel h2 {
    margin-bottom: 2.5rem;
  }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem clamp(1rem, 2vw, 1.75rem);
  }

  /* Lightbox */
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--porcelain);
    color: var(--ink);
  }
  .lb::backdrop {
    background: var(--porcelain);
  }
  .lb-track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .lb-track::-webkit-scrollbar {
    display: none;
  }
  .lb-slide {
    flex: 0 0 100%;
    height: 100%;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    scroll-snap-align: center;
    display: grid;
    place-items: center;
  }
  .lb-slide :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lb-btn {
    position: fixed;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--porcelain) 80%, transparent);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.3s, color 0.3s;
  }
  .lb-btn:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
    font-size: 1.6rem;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 1rem;
  }
  .lb-next {
    right: 1rem;
  }
  .lb-count {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
  }

  @media (max-width: 1100px) {
    .rel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .crumbs {
      padding-block: 1rem;
    }
    .crumbs [aria-current],
    .crumbs span:nth-last-child(2) {
      display: none;
    }
    .pdp {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .galeria {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 0.5rem;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .galeria::-webkit-scrollbar {
      display: none;
    }
    .g-item,
    .g-item.wide,
    .g-item:first-child.tall {
      flex: 0 0 88%;
      aspect-ratio: 4 / 5;
      scroll-snap-align: start;
    }
    .g-count {
      display: block;
      position: absolute;
      left: 0.75rem;
      bottom: 0.75rem;
      background: var(--porcelain);
      padding: 0.3rem 0.65rem;
      font-size: 0.68rem;
      letter-spacing: 0.16em;
      pointer-events: none;
    }
    .info {
      position: static;
    }
    .lb-prev,
    .lb-next {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .vizinhas {
      grid-template-columns: 1fr;
    }
    .vizinhas a[rel='next'] {
      border-left: 0;
      border-top: 1px solid var(--line);
      text-align: left;
    }
  }
</style>

<script>
  const galeria = document.querySelector<HTMLElement>('[data-galeria]');
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]');
  const track = document.querySelector<HTMLElement>('[data-lb-track]');
  const atualLb = document.querySelector<HTMLElement>('[data-lb-atual]');
  const atualG = document.querySelector<HTMLElement>('[data-g-atual]');

  const irPara = (i: number, suave = true) => {
    if (!track) return;
    const n = track.children.length;
    const alvo = (i + n) % n;
    track.scrollTo({ left: alvo * track.clientWidth, behavior: suave ? 'smooth' : 'instant' });
  };
  const indiceAtual = () => (track ? Math.round(track.scrollLeft / track.clientWidth) : 0);

  galeria?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-zoom]');
    if (!b || !lb) return;
    // No celular a galeria já é um carrossel; o zoom abre em tela cheia do mesmo jeito.
    lb.showModal();
    requestAnimationFrame(() => irPara(Number(b.dataset.zoom), false));
  });

  track?.addEventListener(
    'scroll',
    () => {
      if (atualLb) atualLb.textContent = String(indiceAtual() + 1);
    },
    { passive: true },
  );
  document.querySelector('[data-lb-close]')?.addEventListener('click', () => lb?.close());
  document.querySelector('[data-lb-prev]')?.addEventListener('click', () => irPara(indiceAtual() - 1));
  document.querySelector('[data-lb-next]')?.addEventListener('click', () => irPara(indiceAtual() + 1));
  lb?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') irPara(indiceAtual() + 1);
    if (e.key === 'ArrowLeft') irPara(indiceAtual() - 1);
  });
  lb?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).classList.contains('lb-slide')) lb.close();
  });

  // Contador do carrossel no celular
  galeria?.addEventListener(
    'scroll',
    () => {
      if (!atualG || !galeria) return;
      const item = galeria.querySelector<HTMLElement>('.g-item');
      if (!item) return;
      const passo = item.offsetWidth + 8;
      atualG.textContent = String(
        Math.min(Math.round(galeria.scrollLeft / passo) + 1, galeria.querySelectorAll('.g-item').length),
      );
    },
    { passive: true },
  );
</script>
