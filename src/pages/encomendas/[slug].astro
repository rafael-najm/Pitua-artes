---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PersonalizavelCard from '../../components/PersonalizavelCard.astro';
import { personalizaveis, formatarPreco, type PecaPersonalizavel } from '../../data/personalizar';
import { linkWhatsapp } from '../../data/site';
import { u } from '../../lib/url';

export function getStaticPaths() {
  return personalizaveis.map((peca) => ({ params: { slug: peca.slug }, props: { peca } }));
}

interface Props {
  peca: PecaPersonalizavel & { foto: ImageMetadata };
}
const { peca } = Astro.props;
const preco = formatarPreco(peca.aPartirDe);
const urlPeca = new URL(Astro.url.pathname, Astro.site).toString();
const msg = `Olá! Quero encomendar a peça "${peca.nome}" (a partir de ${preco}) com pintura personalizada.\n${urlPeca}`;
const msgDisponibilidade = `Olá! Gostaria de consultar a disponibilidade da peça "${peca.nome}" para personalizar.\n${urlPeca}`;
const outras = personalizaveis.filter((p) => p.slug !== peca.slug);

const passos = [
  ['Conversa', 'Você conta a ideia, a ocasião e manda referências.'],
  ['Desenho', 'A artista propõe a composição e as cores antes de começar.'],
  ['Pintura', 'A peça é pintada à mão, camada por camada.'],
  ['Entrega', 'Embalada com cuidado e entregue no prazo combinado.'],
];
---

<Base titulo={peca.nome} descricao={`${peca.nome} com pintura personalizada — ${peca.chamada} A partir de ${preco}.`} imagem={peca.foto}>
  <nav class="crumbs wrap" aria-label="Você está em">
    <a href={u('/encomendas/')}>Encomendas</a>
    <span aria-hidden="true">/</span>
    <a href={u('/encomendas/#personalizar')}>Peças para personalizar</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{peca.nome}</span>
  </nav>

  <article class="pp wrap">
    <figure class="pp-media">
      <div class="frame pp-img">
        <Image
          src={peca.foto}
          alt={peca.alt}
          widths={[480, 720, 960, 1254]}
          sizes="(max-width: 900px) 100vw, 55vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>A peça em porcelana branca, antes da pintura. A arte é criada para você.</figcaption>
    </figure>

    <aside class="pp-info">
      <div class="pp-info-in">
        <p class="eyebrow">Peça para personalizar</p>
        <h1 class="pp-nome">{peca.nome}</h1>
        <p class="pp-chamada">{peca.chamada}</p>

        <div class="pp-preco">
          <p class="eyebrow">A partir de</p>
          <p class="pp-valor">{preco}</p>
          <p class="pp-nota">O valor final depende da arte escolhida.</p>
        </div>

        <div class="pp-acoes">
          <a class="btn btn--block" href={linkWhatsapp(msg)} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            Encomendar pelo WhatsApp
          </a>
          <a class="btn btn--ghost btn--block" href={linkWhatsapp(msgDisponibilidade)} target="_blank" rel="noopener">
            Consultar disponibilidade
          </a>
          <p class="pp-alt">
            Prefere contar a ideia com calma? <a href={u(`/encomendas/?peca=${peca.slug}#formulario`)}>Use o formulário</a>.
          </p>
        </div>

        <div class="pp-desc">
          {peca.descricao.map((p) => <p>{p}</p>)}
        </div>

        <div class="pp-ficha">
          <dl class="dl">
            <dt>Material</dt><dd>{peca.material}</dd>
            {peca.formato && (<><dt>Formato</dt><dd>{peca.formato}</dd></>)}
            {peca.composicao && (<><dt>Composição</dt><dd>{peca.composicao}</dd></>)}
          </dl>
          {
            peca.medidas.map((m) => (
              <div class="pp-bloco">
                <p class="eyebrow">{m.titulo ? `Medidas aproximadas · ${m.titulo}` : 'Medidas aproximadas'}</p>
                <dl class="dl">
                  {m.itens.map(([r, v]) => (
                    <>
                      <dt>{r}</dt>
                      <dd>{v}</dd>
                    </>
                  ))}
                </dl>
              </div>
            ))
          }
          <p class="pp-ficha-nota">
            Medidas aproximadas: por ser feita em porcelana e finalizada à mão, cada peça pode ter pequenas variações.
          </p>
        </div>

        <div class="pp-acc">
          <details class="acc">
            <summary>Como funciona</summary>
            <div class="acc-body">
              <ol class="pp-passos">
                {passos.map(([t, d]) => <li><strong>{t}.</strong> {d}</li>)}
              </ol>
            </div>
          </details>
          <details class="acc">
            <summary>Cuidados</summary>
            <div class="acc-body">
              <p>Para preservar a pintura por muitos anos, prefira lavar à mão, com esponja macia e detergente neutro.</p>
              <p>Peças com detalhes em ouro não devem ir ao micro-ondas.</p>
            </div>
          </details>
        </div>
      </div>
    </aside>
  </article>

  <section class="outras wrap" aria-labelledby="outras-t">
    <h2 id="outras-t" class="h3">Outras peças para personalizar</h2>
    <div class="outras-grid">
      {outras.map((p) => <PersonalizavelCard peca={p} sizes="(max-width: 1100px) 50vw, 25vw" />)}
    </div>
  </section>
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-block: 1.5rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .crumbs a:hover,
  .crumbs [aria-current] {
    color: var(--ink);
  }

  .pp {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 3.6vw, 4.0rem);
    align-items: start;
    padding-bottom: clamp(2.75rem, 4.8vw, 4.25rem);
  }
  .pp-media {
    margin: 0;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .pp-img {
    aspect-ratio: 1;
  }
  .pp-media figcaption {
    margin-top: 0.85rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .pp-info-in {
    display: grid;
    gap: 1.4rem;
  }
  .pp-nome {
    font-size: clamp(2.2rem, 3.4vw, 3.1rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .pp-chamada {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.3rem;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .pp-preco {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
  }
  .pp-valor {
    font-family: var(--serif);
    font-size: 2.4rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .pp-nota {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .pp-acoes {
    display: grid;
    gap: 0.75rem;
  }
  .pp-alt {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .pp-alt a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pp-ficha-nota {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .pp-desc {
    display: grid;
    gap: 0.9rem;
    color: var(--ink-2);
    font-size: 1.02rem;
  }
  .pp-ficha {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--porcelain);
    border: 1px solid var(--line);
  }
  .pp-bloco {
    display: grid;
    gap: 0.75rem;
  }
  .dl {
    display: grid;
    grid-template-columns: minmax(7.5rem, auto) 1fr;
    gap: 0.55rem 1.5rem;
    margin: 0;
  }
  .dl dt {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .dl dd {
    margin: 0;
  }
  .pp-passos {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
  }
  .pp-passos strong {
    font-weight: 500;
  }

  .outras {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 4.2vw, 3.5rem) clamp(3.5rem, 5.4vw, 4.75rem);
  }
  .outras h2 {
    margin-bottom: 2.5rem;
  }
  .outras-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem clamp(1rem, 2vw, 1.75rem);
  }

  @media (max-width: 1100px) {
    .outras-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .crumbs {
      padding-block: 1rem;
    }
    .crumbs [aria-current],
    .crumbs span:nth-last-child(2) {
      display: none;
    }
    .pp {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .pp-media {
      position: static;
    }
  }
</style>
