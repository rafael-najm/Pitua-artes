---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { linkWhatsapp } from '../data/site';
import { foto, editorial } from '../lib/fotos';
import { formatos } from '../data/oficinas';
import { u } from '../lib/url';
import PinceisFundo from '../components/PinceisFundo.astro';

---

<Base
  titulo="Oficinas"
  descricao="Aulas de pintura em porcelana, oficina criativa com um projeto novo a cada semana, workshops de 2 a 4 aulas e oficinas temáticas, com a Pituá."
  imagem={foto('copos-pintados', 1)}
>
  <section class="of-hero">
    <PinceisFundo class="of-pinceis" />
    <div class="of-head wrap">
    <div class="of-head-txt">
      <p class="eyebrow" data-reveal>Oficinas</p>
      <h1 class="display" data-reveal style="--delay:.06s">Pegue no <em>pincel.</em></h1>
      <p class="lede" data-reveal style="--delay:.12s">
        Aulas regulares, workshops e encontros criativos — com a orientação da artista, cor e boa companhia.
      </p>
    </div>
    </div>
  </section>

  <nav class="of-indice wrap" aria-label="Formatos de oficina">
    <ol>
      {
        formatos.map((f, i) => (
          <li data-reveal style={`--delay:${i * 0.05}s`}>
            <a href={`#${f.id}`}>
              <span class="ind-n serif">{String(i + 1).padStart(2, '0')}</span>
              <span class="ind-t">{f.rotulo}</span>
              <span class="ind-r">{f.resumo}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <section class="of-faixa" aria-hidden="true">
    <div class="of-faixa-in">
      {
        [
          foto('copos-pintados', 1),
          editorial('faixa-consome-tropical'),
          editorial('faixa-cachepo-elefante'),
          foto('jarra-olho-grego', 1),
          foto('manteigueira-borboletas', 1),
        ].map((img, i) => (
          <div class:list={['of-faixa-item frame', i % 2 ? 'pebble-2' : 'pebble']} data-reveal style={`--delay:${i * 0.06}s`}>
            <Image src={img} alt="" widths={[320, 480, 640]} sizes="(max-width: 700px) 40vw, 18vw" />
          </div>
        ))
      }
    </div>
  </section>

  {
    formatos.map((f, i) => (
      <section id={f.id} class:list={['formato wrap', { 'formato--rev': i % 2 }]} aria-labelledby={`${f.id}-t`}>
        <div class="formato-media frame" data-reveal style={`--ratio-mob:${f.ratioMob}`}>
          <Image src={f.img} alt={f.alt} widths={[480, 720, 960, 1280]} sizes="(max-width: 700px) 1px, (max-width: 900px) 100vw, 45vw" class="fm-desk" />
          <Image src={f.imgMob} alt="" widths={[480, 720, 1080]} sizes="(max-width: 700px) 100vw, 1px" class="fm-mob" />
        </div>
        <div class="formato-text" data-reveal style="--delay:.1s">
          <p class="srv-n serif">{String(i + 1).padStart(2, '0')}</p>
          <p class="eyebrow">{f.rotulo}</p>
          <h2 id={`${f.id}-t`} class="h2">{f.titulo}</h2>
          {f.texto.map((t) => <p class="body-lg">{t}</p>)}
          <ul class="formato-tags">
            {f.detalhes.map((d) => <li>{d}</li>)}
          </ul>
          <a class="btn" href={linkWhatsapp(f.msg)} target="_blank" rel="noopener">
            {f.cta}
          </a>
        </div>
      </section>
    ))
  }

  <section class="of-info on-dark">
    <div class="wrap of-info-in">
      <p class="of-info-txt" data-reveal>
        Datas, vagas e valores são divulgados a cada nova turma. Chame no WhatsApp para entrar na lista e saber antes de todo mundo.
      </p>
      <div class="of-info-acoes" data-reveal style="--delay:.08s">
        <a class="btn btn--light" href={linkWhatsapp('Olá! Quero entrar na lista das próximas oficinas. (Oficinas · Entrar na lista)')} target="_blank" rel="noopener">Entrar na lista</a>
        <a class="link" href={u('/acervo/')}>Ver as peças do ateliê <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .of-hero {
    position: relative;
    overflow: hidden;
  }
  .of-hero :global(.of-pinceis) {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(46vw, 760px);
    z-index: 0;
    animation: pinceis-in 1.6s var(--ease) both;
  }
  @keyframes pinceis-in {
    from {
      opacity: 0;
      transform: translateX(40px);
    }
  }
  .of-head {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: 2rem 3rem;
    padding-top: clamp(1.75rem, 3.0vw, 2.75rem);
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
  }
  .of-head-txt {
    display: grid;
    gap: 1.25rem;
  }
  @media (max-width: 800px) {
    .of-head {
      grid-template-columns: 1fr;
      padding-bottom: 10.5rem;
    }
    .of-hero :global(.of-pinceis) {
      top: auto;
      height: 10rem;
      width: 100vw;
    }
  }
  .of-head em {
    font-weight: 300;
  }
  .of-head .lede {
    max-width: 30em;
  }

  .of-faixa {
    overflow: hidden;
    padding-bottom: clamp(2.75rem, 4.8vw, 4.25rem);
  }
  .of-faixa-in {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 2rem);
    width: min(100% - 2 * var(--gutter), var(--max) - 2 * var(--gutter));
    margin-inline: auto;
    align-items: center;
  }
  .of-faixa-item {
    aspect-ratio: 1;
  }
  .of-faixa-item:nth-child(even) {
    transform: translateY(18%);
  }
  .js .of-faixa-item[data-reveal].is-in:nth-child(even) {
    transform: translateY(18%);
  }

  .of-indice {
    padding-bottom: clamp(2.0rem, 3.6vw, 3.0rem);
  }
  .of-indice ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .of-indice li + li {
    border-left: 1px solid var(--line);
  }
  .of-indice a {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    height: 100%;
    padding: 1.4rem 1.25rem 1.5rem;
    transition: background 0.4s var(--ease);
  }
  .of-indice li:first-child a {
    padding-left: 0;
  }
  .of-indice a:hover {
    background: var(--creme);
  }
  .ind-n {
    font-size: 1.6rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--accent);
  }
  .ind-t {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 350;
    line-height: 1.2;
    color: var(--brand);
  }
  .ind-r {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .formato-tags {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .formato-tags li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .formato-tags li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--verde);
  }
  .formato {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem;
    align-items: center;
    padding-block: clamp(2.0rem, 4.2vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .formato-media {
    grid-column: 1 / span 5;
    aspect-ratio: 4 / 5;
  }
  .formato-text {
    grid-column: 7 / span 5;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .formato--rev .formato-media {
    grid-column: 8 / span 5;
    grid-row: 1;
  }
  .formato--rev .formato-text {
    grid-column: 2 / span 5;
    grid-row: 1;
  }
  .formato-text .btn {
    margin-top: 0.75rem;
  }
  .srv-n {
    font-size: 4.5rem;
    font-weight: 300;
    font-style: italic;
    line-height: 0.8;
    color: var(--accent);
  }

  .of-info {
    background: var(--night);
    color: var(--on-night);
    padding-block: clamp(3.25rem, 5.4vw, 4.5rem);
  }
  .of-info-in {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem;
    align-items: center;
  }
  .of-info-txt {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.25;
    font-weight: 280;
    letter-spacing: -0.02em;
  }
  .of-info-acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    justify-content: flex-end;
  }

  @media (max-width: 1000px) {
    .of-indice ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .of-indice li:nth-child(3) {
      border-left: 0;
    }
    .of-indice li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .of-indice li:nth-child(3) a {
      padding-left: 0;
    }
  }
  @media (max-width: 600px) {
    .of-indice ol {
      grid-template-columns: 1fr;
    }
    .of-indice li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .of-indice a {
      padding-left: 0;
    }
  }
  @media (max-width: 900px) {
    .formato,
    .formato--rev {
      grid-template-columns: 1fr;
    }
    .formato-media,
    .formato-text,
    .formato--rev .formato-media,
    .formato--rev .formato-text {
      grid-column: auto;
      grid-row: auto;
    }
    .of-info-in {
      grid-template-columns: 1fr;
    }
    .of-info-acoes {
      justify-content: flex-start;
    }
  }
  .formato-media :global(.fm-mob) {
    display: none;
  }
  @media (max-width: 700px) {
    .formato-media :global(.fm-desk) {
      display: none;
    }
    .formato-media :global(.fm-mob) {
      display: block;
    }
  }
  /* Celular: título primeiro, foto paisagem no meio, depois texto e botão */
  @media (max-width: 700px) {
    .formato,
    .formato--rev {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-block: 2.75rem;
    }
    .formato-text {
      display: contents;
    }
    .formato .srv-n {
      order: 1;
      font-size: 2.6rem;
      margin-bottom: 0.6rem;
    }
    .formato .eyebrow {
      order: 2;
      margin-bottom: 0.5rem;
    }
    .formato .h2 {
      order: 3;
      font-size: 1.95rem;
      margin-bottom: 1.25rem;
    }
    .formato-media,
    .formato--rev .formato-media {
      order: 4;
      width: 100%;
      aspect-ratio: var(--ratio-mob, 3 / 2);
      margin-bottom: 1.25rem;
      opacity: 1;
      transform: none;
    }
    .formato .body-lg {
      order: 5;
      margin-bottom: 0.75rem;
    }
    .formato-tags {
      order: 6;
      margin-bottom: 1.25rem;
    }
    .formato .btn {
      order: 7;
      margin-top: 0;
      width: 100%;
    }
  }
  @media (max-width: 700px) {
    .of-faixa-in {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .of-faixa-item:nth-child(n + 4) {
      display: none;
    }
  }
</style>
