---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { linkWhatsapp } from '../data/site';
import { foto, editorial } from '../lib/fotos';
import { u } from '../lib/url';
import PinceisFundo from '../components/PinceisFundo.astro';

const formatos = [
  {
    id: 'pintura-em-porcelana',
    rotulo: 'Aulas de pintura em porcelana',
    titulo: 'A sua peça, do primeiro traço ao acabamento.',
    resumo: 'Aulas recorrentes: você escolhe a peça e faz tudo.',
    texto: [
      'Você escolhe a sua peça de porcelana e faz tudo, com a orientação da artista: escolhe o desenho, monta a composição, define as cores e produz a peça do início ao fim.',
      'Um aprendizado contínuo, no seu ritmo — a cada peça, mais técnica e mais segurança no pincel.',
    ],
    detalhes: ['Aulas semanais', '3 horas por aula', 'Turma recorrente'],
    cta: 'Quero fazer aulas',
    msg: 'Olá! Tenho interesse nas aulas de pintura em porcelana da Pituá. Como funcionam as turmas?',
    img: editorial('oficina-aulas-travessa'),
    alt: 'Travessa retangular pintada com limões e azulejos azuis, servindo bolo de rolo',
  },
  {
    id: 'criativa',
    rotulo: 'Oficina criativa',
    titulo: 'Um projeto novo a cada encontro.',
    resumo: 'Aulas semanais, cada uma com um projeto diferente.',
    texto: [
      'A cada semana, um projeto diferente: pintura em porcelana, vidro, decoupage, dobraduras e muito mais.',
      'Criatividade solta — um material, uma técnica e uma descoberta nova a cada encontro.',
    ],
    detalhes: ['Aulas semanais', '3 horas por aula', 'Porcelana, vidro, decoupage, dobraduras…'],
    cta: 'Quero participar',
    msg: 'Olá! Tenho interesse na oficina criativa da Pituá. Como funcionam as turmas?',
    img: foto('bomboniere-arlequim', 1),
    alt: 'Bomboniere de vidro pintada à mão, com tampa amarela, pé listrado e bolinhas',
  },
  {
    id: 'workshops',
    rotulo: 'Workshops',
    titulo: 'Um projeto, do começo ao fim, em 2 a 4 aulas.',
    resumo: 'Um projeto escolhido, desenvolvido em 2 a 4 aulas.',
    texto: [
      'A cada workshop, um projeto escolhido — em porcelana, vidro ou outra técnica — desenvolvido ao longo de 2, 3 ou 4 aulas, com o passo a passo guiado pela artista.',
      'Para quem quer se aprofundar numa peça com calma e terminar o workshop com ela pronta.',
    ],
    detalhes: ['Projeto definido', '2, 3 ou 4 aulas', 'Porcelana, vidro e outras técnicas'],
    cta: 'Quero saber dos próximos workshops',
    msg: 'Olá! Tenho interesse nos workshops da Pituá. Quais são os próximos projetos?',
    img: foto('consome-geometrico', 1),
    alt: 'Conjunto de consomê pintado com triângulos e círculos em azul e verde',
  },
  {
    id: 'tematicas',
    rotulo: 'Oficinas temáticas',
    titulo: 'Temáticas, pensadas por projeto.',
    resumo: 'Sob medida para datas, grupos e eventos.',
    texto: [
      'Oficinas desenhadas sob medida para uma ocasião: datas comemorativas, aniversários, encontros entre amigas, grupos e empresas.',
      'O tema, a peça e o formato são definidos junto com você.',
    ],
    detalhes: ['Sob medida', 'Grupos e eventos'],
    cta: 'Planejar uma oficina temática',
    msg: 'Olá! Gostaria de planejar uma oficina temática com a Pituá.',
    img: editorial('oficina-tematica-prato'),
    alt: 'Prato fundo pintado com tomates e folhas, sobre jogo americano de palha',
  },
];
---

<Base
  titulo="Oficinas"
  descricao="Aulas de pintura em porcelana, oficina criativa com um projeto novo a cada semana, workshops de 2 a 4 aulas e oficinas temáticas, com a Pituá."
  imagem={foto('copos-pintados', 1)}
>
  <section class="of-hero">
    <PinceisFundo class="of-pinceis" />
    <div class="of-head wrap">
    <div class="of-head-txt">
      <p class="eyebrow" data-reveal>Oficinas</p>
      <h1 class="display" data-reveal style="--delay:.06s">Pegue no <em>pincel.</em></h1>
      <p class="lede" data-reveal style="--delay:.12s">
        Aulas regulares, workshops e encontros criativos — com a orientação da artista, cor e boa companhia.
      </p>
    </div>
    </div>
  </section>

  <nav class="of-indice wrap" aria-label="Formatos de oficina">
    <ol>
      {
        formatos.map((f, i) => (
          <li data-reveal style={`--delay:${i * 0.05}s`}>
            <a href={`#${f.id}`}>
              <span class="ind-n serif">{String(i + 1).padStart(2, '0')}</span>
              <span class="ind-t">{f.rotulo}</span>
              <span class="ind-r">{f.resumo}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <section class="of-faixa" aria-hidden="true">
    <div class="of-faixa-in">
      {
        [
          foto('copos-pintados', 1),
          editorial('faixa-consome-tropical'),
          editorial('faixa-cachepo-elefante'),
          foto('jarra-olho-grego', 1),
          foto('manteigueira-borboletas', 1),
        ].map((img, i) => (
          <div class:list={['of-faixa-item frame', i % 2 ? 'pebble-2' : 'pebble']} data-reveal style={`--delay:${i * 0.06}s`}>
            <Image src={img} alt="" widths={[320, 480, 640]} sizes="(max-width: 700px) 40vw, 18vw" />
          </div>
        ))
      }
    </div>
  </section>

  {
    formatos.map((f, i) => (
      <section id={f.id} class:list={['formato wrap', { 'formato--rev': i % 2 }]} aria-labelledby={`${f.id}-t`}>
        <div class="formato-media frame" data-reveal>
          <Image src={f.img} alt={f.alt} widths={[480, 720, 960, 1280]} sizes="(max-width: 900px) 100vw, 45vw" />
        </div>
        <div class="formato-text" data-reveal style="--delay:.1s">
          <p class="srv-n serif">{String(i + 1).padStart(2, '0')}</p>
          <p class="eyebrow">{f.rotulo}</p>
          <h2 id={`${f.id}-t`} class="h2">{f.titulo}</h2>
          {f.texto.map((t) => <p class="body-lg">{t}</p>)}
          <ul class="formato-tags">
            {f.detalhes.map((d) => <li>{d}</li>)}
          </ul>
          <a class="btn" href={linkWhatsapp(f.msg)} target="_blank" rel="noopener">
            {f.cta}
          </a>
        </div>
      </section>
    ))
  }

  <section class="of-info on-dark">
    <div class="wrap of-info-in">
      <p class="of-info-txt" data-reveal>
        Datas, vagas e valores são divulgados a cada nova turma. Chame no WhatsApp para entrar na lista e saber antes de todo mundo.
      </p>
      <div class="of-info-acoes" data-reveal style="--delay:.08s">
        <a class="btn btn--light" href={linkWhatsapp('Olá! Quero entrar na lista das oficinas da Pituá.')} target="_blank" rel="noopener">Entrar na lista</a>
        <a class="link" href={u('/acervo/')}>Ver as peças do ateliê <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .of-hero {
    position: relative;
    overflow: hidden;
  }
  .of-hero :global(.of-pinceis) {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(46vw, 760px);
    z-index: 0;
    animation: pinceis-in 1.6s var(--ease) both;
  }
  @keyframes pinceis-in {
    from {
      opacity: 0;
      transform: translateX(40px);
    }
  }
  .of-head {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: 2rem 3rem;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
  }
  .of-head-txt {
    display: grid;
    gap: 1.25rem;
  }
  @media (max-width: 800px) {
    .of-head {
      grid-template-columns: 1fr;
      padding-bottom: 10.5rem;
    }
    .of-hero :global(.of-pinceis) {
      top: auto;
      height: 10rem;
      width: 100vw;
    }
  }
  .of-head em {
    font-weight: 300;
  }
  .of-head .lede {
    max-width: 30em;
  }

  .of-faixa {
    overflow: hidden;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .of-faixa-in {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 2rem);
    width: min(100% - 2 * var(--gutter), var(--max) - 2 * var(--gutter));
    margin-inline: auto;
    align-items: center;
  }
  .of-faixa-item {
    aspect-ratio: 1;
  }
  .of-faixa-item:nth-child(even) {
    transform: translateY(18%);
  }
  .js .of-faixa-item[data-reveal].is-in:nth-child(even) {
    transform: translateY(18%);
  }

  .of-indice {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .of-indice ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .of-indice li + li {
    border-left: 1px solid var(--line);
  }
  .of-indice a {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    height: 100%;
    padding: 1.4rem 1.25rem 1.5rem;
    transition: background 0.4s var(--ease);
  }
  .of-indice li:first-child a {
    padding-left: 0;
  }
  .of-indice a:hover {
    background: var(--creme);
  }
  .ind-n {
    font-size: 1.6rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--accent);
  }
  .ind-t {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 350;
    line-height: 1.2;
    color: var(--brand);
  }
  .ind-r {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .formato-tags {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .formato-tags li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .formato-tags li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--verde);
  }
  .formato {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem;
    align-items: center;
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .formato-media {
    grid-column: 1 / span 5;
    aspect-ratio: 4 / 5;
  }
  .formato-text {
    grid-column: 7 / span 5;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .formato--rev .formato-media {
    grid-column: 8 / span 5;
    grid-row: 1;
  }
  .formato--rev .formato-text {
    grid-column: 2 / span 5;
    grid-row: 1;
  }
  .formato-text .btn {
    margin-top: 0.75rem;
  }
  .srv-n {
    font-size: 4.5rem;
    font-weight: 300;
    font-style: italic;
    line-height: 0.8;
    color: var(--accent);
  }

  .of-info {
    background: var(--night);
    color: var(--on-night);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .of-info-in {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem;
    align-items: center;
  }
  .of-info-txt {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.25;
    font-weight: 280;
    letter-spacing: -0.02em;
  }
  .of-info-acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    justify-content: flex-end;
  }

  @media (max-width: 1000px) {
    .of-indice ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .of-indice li:nth-child(3) {
      border-left: 0;
    }
    .of-indice li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .of-indice li:nth-child(3) a {
      padding-left: 0;
    }
  }
  @media (max-width: 600px) {
    .of-indice ol {
      grid-template-columns: 1fr;
    }
    .of-indice li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .of-indice a {
      padding-left: 0;
    }
  }
  @media (max-width: 900px) {
    .formato,
    .formato--rev {
      grid-template-columns: 1fr;
    }
    .formato-media,
    .formato-text,
    .formato--rev .formato-media,
    .formato--rev .formato-text {
      grid-column: auto;
      grid-row: auto;
    }
    .of-info-in {
      grid-template-columns: 1fr;
    }
    .of-info-acoes {
      justify-content: flex-start;
    }
  }
  @media (max-width: 700px) {
    .of-faixa-in {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .of-faixa-item:nth-child(n + 4) {
      display: none;
    }
  }
</style>
