<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((p) => {
    const video = p.querySelector('video')!;
    const btn = p.querySelector<HTMLButtonElement>('[data-play]');
    video.controls = false;
    btn?.addEventListener('click', () => {
      video.controls = true;
      video.play();
    });
    video.addEventListener('play', () => p.classList.add('is-playing'));
  });
</script>
