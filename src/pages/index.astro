---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PecaCard from '../components/PecaCard.astro';
import { pecas } from '../data/pecas';
import { site, linkWhatsapp } from '../data/site';
import { foto, editorial } from '../lib/fotos';
import { u } from '../lib/url';
import { formatos } from '../data/oficinas';
import { personalizaveis, formatarPreco } from '../data/personalizar';

const destaques = pecas.filter((p) => p.destaque);

const menorPreco = formatarPreco(Math.min(...personalizaveis.map((p) => p.aPartirDe)));

const frentes = [
  {
    id: 'oficinas',
    rotulo: 'Oficinas',
    titulo: 'Pegue no pincel.',
    texto: 'Aulas, workshops e encontros criativos com a orientação da artista.',
    href: '/oficinas/',
    acao: 'Conhecer as oficinas',
    img: editorial('frente-oficinas-queijeira'),
    alt: 'Queijeira pintada à mão com hibiscos amarelos e laranja, tampa aberta',
    forma: 'pebble',
    itens: formatos.map((f) => ({ nome: f.rotulo, desc: f.resumo, href: `/oficinas/#${f.id}` })),
  },
  {
    id: 'encomendas',
    rotulo: 'Encomendas',
    titulo: 'Feita para você.',
    texto: 'Peças pintadas à mão a partir da sua ideia, da sua história e das cores da sua casa.',
    href: '/encomendas/',
    acao: 'Fazer uma encomenda',
    img: editorial('frente-encomendas-elefante'),
    alt: 'Escultura de elefante com manta pintada em rosa, ouro e verde-esmeralda',
    forma: 'pebble-2',
    itens: [
      {
        nome: 'Peças para personalizar',
        desc: `Escolha a peça; a arte é sua. A partir de ${menorPreco}.`,
        href: '/encomendas/#personalizar',
      },
      { nome: 'Projetos sob medida', desc: 'Da mesa de jantar ao lavabo, criados do zero.', href: '/encomendas/#sob-medida' },
      { nome: 'Inspire-se no acervo', desc: 'Qualquer peça do acervo pode inspirar uma nova.', href: '/acervo/' },
    ],
  },
];

const usos = [
  { slug: 'petisqueira-aquarela', video: 'petisqueira', nome: 'Petisqueira Aquarela' },
  { slug: 'manteigueira-borboletas', video: 'manteigueira', nome: 'Manteigueira Borboletas' },
  { slug: 'latinhas-sardinha-e-atum', video: 'latinhas', nome: 'Latinhas Sardinha & Atum' },
];

const artista = site.artista;
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow" data-reveal>Pintura em porcelana · Peças únicas</p>
      <h1 class="display" data-reveal style="--delay:.08s">
        Um universo de cores <em>feitas à mão.</em>
      </h1>
      <p class="lede hero-lede" data-reveal style="--delay:.16s">
        Pinturas em porcelana e oficinas criativas. Cada peça é pintada uma a uma — e nenhuma se repete.
      </p>
      <div class="hero-cta" data-reveal style="--delay:.24s">
        <a class="btn" href={u('/acervo/')}>Conheça as artes</a>
        <a class="link" href={u('/encomendas/')}>Encomendar uma peça <span class="arrow">→</span></a>
      </div>
    </div>
    <a class="hero-media frame" href={u('/acervo/jardineira-mata-atlantica/')}>
      <Image
        src={editorial('hero-araras')}
        alt="Detalhe de um casal de araras-azuis pintado à mão em porcelana, pousado num galho entre folhagens"
        widths={[720, 960, 1280, 1600, 2000]}
        sizes="(max-width: 900px) 100vw, 58vw"
        loading="eager"
        fetchpriority="high"
      />
      <span class="hero-cap">Jardineira Mata Atlântica — detalhe</span>
    </a>
  </section>

  <!-- O QUE ACONTECE POR AQUI -->
  <section class="servicos section" aria-labelledby="servicos-titulo">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow">O ateliê</p>
        <h2 id="servicos-titulo" class="h2">O que acontece por aqui</h2>
      </header>

      <div class="frentes">
        {
          frentes.map((f, i) => (
            <article class="frente" id={`frente-${f.id}`} data-reveal style={`--delay:${i * 0.1}s`}>
              <a class:list={['frente-media frame', f.forma]} href={u(f.href)} tabindex="-1" aria-hidden="true">
                <Image src={f.img} alt={f.alt} widths={[480, 720, 960]} sizes="(max-width: 900px) 70vw, 30vw" />
              </a>
              <p class="eyebrow">{f.rotulo}</p>
              <h3 class="h2 frente-t">{f.titulo}</h3>
              <p class="body-lg">{f.texto}</p>
              <ol class="frente-lista">
                {f.itens.map((it, j) => (
                  <li>
                    <a href={u(it.href)}>
                      <span class="fl-n serif">{String(j + 1).padStart(2, '0')}</span>
                      <span class="fl-t">{it.nome}</span>
                      <span class="fl-d">{it.desc}</span>
                      <span class="fl-a" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ol>
              <a class="btn" href={u(f.href)}>{f.acao}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FEITAS PARA USAR -->
  <section class="usos section" aria-labelledby="usos-titulo">
    <div class="wrap usos-in">
      <header class="usos-head" data-reveal>
        <p class="eyebrow">À mesa</p>
        <h2 id="usos-titulo" class="h2">Feitas para a mesa de todo dia.</h2>
        <p class="body-lg">
          Porcelana pintada não precisa morar na cristaleira. As peças vão à mesa, recebem o queijo, a manteiga, o
          patê — e ficam ainda mais bonitas em uso.
        </p>
      </header>
      <div class="usos-car">
      <div class="usos-grid" data-carrossel>
        {
          usos.map((v, i) => (
            <a class="uso" href={u(`/acervo/${v.slug}/`)} data-reveal style={`--delay:${i * 0.08}s`}>
              <div class="uso-media frame">
                <video
                  data-loop
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={u(`/video/${v.video}.jpg`)}
                  aria-label={`Vídeo: ${v.nome} em uso`}
                >
                  <source src={u(`/video/${v.video}.mp4`)} type="video/mp4" />
                </video>
              </div>
              <p class="uso-name">
                {v.nome} <span class="arrow">→</span>
              </p>
            </a>
          ))
        }
      </div>
      <div class="car-nav" aria-label="Navegar pelos vídeos">
        <button type="button" class="car-btn" data-car-prev aria-label="Vídeo anterior">←</button>
        <span class="car-dots" aria-hidden="true">{usos.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</span>
        <button type="button" class="car-btn" data-car-next aria-label="Próximo vídeo">→</button>
      </div>
      </div>
    </div>
  </section>

  <!-- ENCOMENDAS -->
  <section class="encomenda" aria-labelledby="encomenda-titulo">
    <div class="encomenda-media frame">
      <Image
        src={foto('cuba-baloes', 1)}
        alt="Cuba de lavabo pintada sob medida, com faixas de padrões e balões coloridos"
        widths={[720, 960, 1280, 1600]}
        sizes="(max-width: 900px) 100vw, 50vw"
      />
      <span class="hero-cap">Cuba Balões — projeto sob medida</span>
    </div>
    <div class="encomenda-text">
      <p class="eyebrow status" data-reveal>Encomendas abertas</p>
      <h2 id="encomenda-titulo" class="h2" data-reveal>Uma peça só sua.</h2>
      <p class="body-lg" data-reveal>
        Do aparelho de jantar à cuba do lavabo, do presente de casamento ao prato de Shabat da família: a peça é
        desenhada a partir da sua ideia e pintada exclusivamente para você.
      </p>
      <ol class="passos" data-reveal>
        <li><span>01</span> Conversa</li>
        <li><span>02</span> Desenho</li>
        <li><span>03</span> Pintura</li>
        <li><span>04</span> Entrega</li>
      </ol>
      <div class="encomenda-cta" data-reveal>
        <a class="btn" href={u('/encomendas/')}>Começar uma encomenda</a>
        <a class="link" href={u('/encomendas/#personalizar')}>Peças para personalizar <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- DESTAQUES -->
  <section class="section destaques" aria-labelledby="destaques-titulo">
    <div class="wrap">
      <header class="sec-head sec-head--row" data-reveal>
        <div>
          <p class="eyebrow">Do acervo</p>
          <h2 id="destaques-titulo" class="h2">Peças em destaque</h2>
        </div>
        <a class="link" href={u('/acervo/')}>Ver as {pecas.length} peças <span class="arrow">→</span></a>
      </header>
      <div class="rail" data-reveal>
        {destaques.map((p) => <PecaCard peca={p} sizes="(max-width: 700px) 72vw, (max-width: 1100px) 33vw, 25vw" />)}
      </div>
    </div>
  </section>

  <!-- ARTISTA -->
  <section class="artista section" aria-labelledby="artista-titulo">
    <div class="wrap artista-in">
      <div class="artista-media frame pebble-2" data-reveal>
        <Image
          src={editorial('artista-retrato')}
          alt={artista ? `${artista}, artista da Pituá, segurando uma de suas peças` : 'A artista da Pituá segurando uma de suas peças'}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 900px) 90vw, 40vw"
        />
      </div>
      <div class="artista-text" data-reveal style="--delay:.1s">
        <p class="eyebrow">A artista</p>
        <h2 id="artista-titulo" class="h2">Por trás de cada peça, as mesmas mãos.</h2>
        <p class="body-lg">
          {artista} é apaixonada por pintura em porcelana desde os 11 anos — e, de lá pra cá, nunca mais parou. Na Pituá,
          cada peça passa pelas mãos dela, do primeiro desenho à última pincelada: um trabalho paciente e detalhista, que
          mistura as cores do Brasil, padrões do mundo inteiro e muitas histórias de família.
        </p>
        <blockquote class="artista-frase">
          <p>
            Toda peça começa em branco. Depois vêm o desenho, o pincel e as camadas de cor — até a porcelana
            virar <em>obra</em>.
          </p>
        </blockquote>
        <button class="video-card" type="button" data-abre-video="apresentacao">
          <span class="vc-thumb frame">
            <img src={u('/video/apresentacao-nathaly.jpg')} alt="" width="72" height="128" loading="lazy" />
            <span class="vc-play" aria-hidden="true"
              ><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg></span
            >
          </span>
          <span class="vc-txt">
            <span class="eyebrow">Vídeo · 1 min</span>
            <span class="vc-t">Prazer, eu sou a {artista}.</span>
          </span>
        </button>
        <a class="link" href={linkWhatsapp('Olá, Nathaly! Queria conversar sobre uma peça. (Página inicial · A artista)')} target="_blank" rel="noopener">
          Conversar com a {artista} <span class="arrow">→</span>
        </a>
        <dialog class="video-dialog" data-video="apresentacao" aria-label={`Vídeo: ${artista} se apresenta`}>
          <video controls playsinline preload="none" poster={u('/video/apresentacao-nathaly.jpg')}>
            <source src={u('/video/apresentacao-nathaly.mp4')} type="video/mp4" />
          </video>
          <button class="vd-close" type="button" data-fecha-video aria-label="Fechar vídeo">×</button>
        </dialog>
      </div>
    </div>
  </section>

  <!-- HISTÓRIA -->
  <section class="historia on-dark" aria-labelledby="historia-titulo">
    <div class="wrap historia-in">
      <div class="historia-video" data-reveal>
        <div class="player frame" data-player>
          <video
            controls
            playsinline
            preload="none"
            poster={u('/video/historia-prato-shabat-avo.jpg')}
            aria-label="Vídeo: a história do Prato de Shabat inspirado no desenho do avô da Nathaly"
          >
            <source src={u('/video/historia-prato-shabat-avo.mp4')} type="video/mp4" />
          </video>
          <button class="player-btn" type="button" data-play>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
            <span>Assistir · 44s</span>
          </button>
        </div>
      </div>
      <div class="historia-text" data-reveal style="--delay:.1s">
        <p class="eyebrow">A história por trás da peça</p>
        <h2 id="historia-titulo" class="h2">Paz, Salam, Shalom.</h2>
        <p class="body-lg">
          O avô da {artista} era fluente em árabe, hebraico e português. Entre os desenhos que deixou, havia uma folha de
          papel com três palavras — <em>Paz</em>, <em>Salam</em> e <em>Shalom</em>.
        </p>
        <p class="body-lg">
          A folha virou um prato de Shabat, que recebe as chalot toda sexta-feira e em todas as festas da família — e
          ganhou a companhia de um kos para o kidush.
        </p>
        <blockquote class="quote">
          <p>“Uma memória que ganhou forma, virou porcelana e deixa meu avô ainda mais eterno em nossa família.”</p>
        </blockquote>
        <div class="historia-pecas">
          <a class="mini" href={u('/acervo/prato-de-shabat/')}>
            <span class="mini-img frame">
              <Image src={foto('prato-de-shabat', 1)} alt="" widths={[160, 240]} sizes="80px" />
            </span>
            <span>Prato de Shabat <span class="arrow">→</span></span>
          </a>
          <a class="mini" href={u('/acervo/taca-de-kidush/')}>
            <span class="mini-img frame">
              <Image src={foto('taca-de-kidush', 1)} alt="" widths={[160, 240]} sizes="80px" />
            </span>
            <span>Kos de Kidush <span class="arrow">→</span></span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    min-height: calc(100svh - var(--header-h));
    max-height: 1100px;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.75rem;
    padding: 3rem clamp(1.0rem, 2.4vw, 2.5rem) 4rem max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
  }
  .hero-text .display em {
    display: block;
    font-weight: 300;
  }
  .hero-lede {
    max-width: 26em;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 0.5rem;
  }
  .hero-media {
    display: block;
    height: 100%;
    min-height: 520px;
  }
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    object-position: 50% 50%;
    animation: hero-zoom 2.4s var(--ease) both;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
      opacity: 0;
    }
  }
  .hero-cap {
    position: absolute;
    right: 1.25rem;
    bottom: 1.1rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }

  /* SEÇÕES */
  .sec-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.0rem, 3.6vw, 3.0rem);
  }
  .sec-head--row {
    grid-template-columns: 1fr auto;
    align-items: end;
  }

  /* O QUE ACONTECE POR AQUI */
  .servicos {
    border-top: 1px solid var(--line);
  }
  .frentes {
    --gap: clamp(1.5rem, 3.6vw, 3.5rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .frente:first-child {
    padding-right: var(--gap);
  }
  .frente {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1.1rem;
  }
  .frente + .frente {
    border-left: 1px solid var(--line);
    padding-left: var(--gap);
  }
  .frente-media {
    width: min(64%, 340px);
    aspect-ratio: 1 / 1.05;
    margin-bottom: 0.75rem;
  }
  .frente-media :global(img) {
    transition: transform 1.6s var(--ease);
  }
  .frente-media:hover :global(img) {
    transform: scale(1.04);
  }
  .frente-t {
    font-size: clamp(2rem, 3.4vw, 3rem);
  }
  .frente-lista {
    list-style: none;
    margin: 0.75rem 0 1.25rem;
    padding: 0;
    width: 100%;
    border-top: 1px solid var(--line);
  }
  .frente-lista li {
    border-bottom: 1px solid var(--line);
  }
  .frente-lista a {
    display: grid;
    grid-template-columns: 2.4rem 1fr auto;
    column-gap: 0.75rem;
    align-items: baseline;
    padding: 1rem 0;
    transition: background 0.35s var(--ease);
  }
  .fl-n {
    grid-row: span 2;
    font-size: 1.3rem;
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
  }
  .fl-t {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 350;
    color: var(--brand);
    line-height: 1.25;
  }
  .fl-d {
    grid-column: 2;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .fl-a {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--accent);
    transition: transform 0.45s var(--ease);
  }
  .frente-lista a:hover .fl-a {
    transform: translateX(4px);
  }
  .frente-lista a:hover .fl-t {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  /* DESTAQUES */
  .destaques {
    padding-top: clamp(2.75rem, 4.8vw, 4.25rem);
  }
  .rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2.0rem, 2.88vw, 2.5rem) clamp(1rem, 2vw, 1.75rem);
  }

  /* USOS */
  .usos {
    background: var(--paper-2);
  }
  .usos-in {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(1.5rem, 3.6vw, 3.5rem);
    align-items: center;
  }
  .usos-head {
    display: grid;
    gap: 1.25rem;
  }
  .usos-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .uso {
    display: grid;
    gap: 0.9rem;
  }
  .uso-media {
    aspect-ratio: 9 / 16;
    border-radius: 999px 999px 0 0;
  }
  .uso-name {
    font-family: var(--serif);
    font-weight: 330;
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .uso-name .arrow {
    display: inline-block;
    color: var(--accent);
    transition: transform 0.5s var(--ease);
  }
  .uso:hover .uso-name .arrow {
    transform: translateX(4px);
  }

  .car-nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  .car-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--porcelain);
    color: var(--brand);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .car-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .car-dots {
    display: flex;
    gap: 0.5rem;
  }
  .car-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-strong);
    transition: background 0.3s, transform 0.3s;
  }
  .car-dots i.on {
    background: var(--accent);
    transform: scale(1.25);
  }

  /* HISTÓRIA */
  .historia {
    background: var(--night);
    color: var(--on-night);
    padding-block: clamp(3.5rem, 6.0vw, 5.5rem);
  }
  .historia .eyebrow {
    color: var(--on-night-muted);
  }
  .historia .body-lg {
    color: color-mix(in srgb, var(--on-night) 82%, transparent);
  }
  .historia-in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.0rem, 5.04vw, 5.0rem);
    align-items: center;
  }
  .historia-video {
    max-width: 440px;
    width: 100%;
    justify-self: end;
  }
  .player {
    aspect-ratio: 9 / 16;
    background: var(--night-2);
  }
  .player-btn {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.3rem 0.8rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 999px;
    background: rgb(23 21 19 / 0.35);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s;
  }
  .player-btn:hover {
    background: rgb(23 21 19 / 0.6);
  }
  .player-btn svg {
    width: 18px;
    height: 18px;
  }
  .player.is-playing .player-btn {
    display: none;
  }
  .historia-text {
    display: grid;
