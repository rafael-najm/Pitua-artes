---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PecaCard from '../components/PecaCard.astro';
import { pecas } from '../data/pecas';
import { site, linkWhatsapp } from '../data/site';
import { foto, editorial } from '../lib/fotos';
import { u } from '../lib/url';

const destaques = pecas.filter((p) => p.destaque);

const servicos = [
  {
    n: '01',
    rotulo: 'Pinturas em porcelana',
    titulo: 'Cada peça, única.',
    texto:
      'Vasos, aparelhos de jantar, esculturas e peças de Judaica pintados à mão, um a um. Mesmo quando nascem em par, nunca são idênticos.',
    href: '/acervo/',
    acao: 'Ver o acervo',
    img: foto('jardineira-mata-atlantica', 2),
    alt: 'Detalhe da Jardineira Mata Atlântica: duas araras-azuis pintadas em um galho',
    forma: 'pebble',
  },
  {
    n: '02',
    rotulo: 'Oficinas criativas',
    titulo: 'Um projeto novo a cada encontro.',
    texto:
      'Encontros para quem quer pegar no pincel. A cada oficina, uma peça diferente — do primeiro traço ao acabamento.',
    href: '/oficinas/',
    acao: 'Conhecer as oficinas',
    img: foto('copos-pintados', 1),
    alt: 'Copo de vidro pintado à mão com flores em magenta',
    forma: 'pebble-2',
  },
  {
    n: '03',
    rotulo: 'Oficinas especiais',
    titulo: 'Temáticas, pensadas por projeto.',
    texto:
      'Datas comemorativas, presentes, grupos e eventos: oficinas desenhadas sob medida para cada ocasião.',
    href: '/oficinas/#especiais',
    acao: 'Planejar uma oficina',
    img: foto('boleira-confeitaria', 2),
    alt: 'Boleira vista de cima, pintada com cupcakes, pirulitos e sorvetes',
    forma: 'pebble-3',
  },
  {
    n: '04',
    rotulo: 'Peças autorais',
    titulo: 'Encomende a sua, personalizada.',
    texto:
      'Nomes, datas, caligrafias de família, as cores da sua casa. Uma peça criada a partir da sua história.',
    href: '/encomendas/',
    acao: 'Fazer uma encomenda',
    img: foto('casticais-shabat-shalom', 1),
    alt: 'Par de castiçais com as palavras Shabat e Shalom pintadas em hebraico',
    forma: 'pebble',
  },
];

const usos = [
  { slug: 'petisqueira-aquarela', video: 'petisqueira', nome: 'Petisqueira Aquarela' },
  { slug: 'manteigueira-borboletas', video: 'manteigueira', nome: 'Manteigueira Borboletas' },
  { slug: 'latinhas-sardinha-e-atum', video: 'latinhas', nome: 'Latinhas Sardinha & Atum' },
];

const artista = site.artista;
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow" data-reveal>Pintura em porcelana · Peças únicas</p>
      <h1 class="display" data-reveal style="--delay:.08s">
        Um universo de cores <em>feitas à mão.</em>
      </h1>
      <p class="lede hero-lede" data-reveal style="--delay:.16s">
        Pinturas em porcelana e oficinas criativas. Cada peça é pintada uma a uma — e nenhuma se repete.
      </p>
      <div class="hero-cta" data-reveal style="--delay:.24s">
        <a class="btn" href={u('/acervo/')}>Conheça as artes</a>
        <a class="link" href={u('/encomendas/')}>Encomendar uma peça <span class="arrow">→</span></a>
      </div>
    </div>
    <a class="hero-media frame" href={u('/acervo/potiches-orquideas/')}>
      <Image
        src={foto('potiches-orquideas', 2)}
        alt="Detalhe de uma orquídea rosa pintada à mão sobre porcelana branca em relevo"
        widths={[720, 960, 1280, 1600, 2000]}
        sizes="(max-width: 900px) 100vw, 58vw"
        loading="eager"
        fetchpriority="high"
      />
      <span class="hero-cap">Potiches Orquídeas — detalhe</span>
    </a>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto section">
    <div class="wrap">
      <p class="manifesto-txt" data-reveal>
        Toda peça começa em branco. Depois vêm o desenho, o pincel e as camadas de cor — até a porcelana
        virar <em>obra</em>.
      </p>
      <ul class="pilares" data-reveal style="--delay:.1s">
        <li><span class="serif it">i.</span> Pintadas à mão, uma a uma</li>
        <li><span class="serif it">ii.</span> Peças únicas e autorais</li>
        <li><span class="serif it">iii.</span> Encomendas sob medida</li>
      </ul>
    </div>
  </section>

  <!-- O QUE ACONTECE POR AQUI -->
  <section class="servicos" aria-labelledby="servicos-titulo">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <p class="eyebrow">O ateliê</p>
        <h2 id="servicos-titulo" class="h2">O que acontece por aqui</h2>
      </header>

      <ol class="srv-list">
        {
          servicos.map((s, i) => (
            <li class:list={['srv', { 'srv--rev': i % 2 === 1 }]}>
              <a class:list={['srv-media frame', s.forma]} href={u(s.href)} tabindex="-1" aria-hidden="true" data-reveal>
                <Image src={s.img} alt={s.alt} widths={[480, 720, 960, 1280]} sizes="(max-width: 900px) 90vw, 42vw" />
              </a>
              <div class="srv-text" data-reveal style="--delay:.1s">
                <p class="srv-n serif">{s.n}</p>
                <p class="eyebrow">{s.rotulo}</p>
                <h3 class="h3">{s.titulo}</h3>
                <p class="body-lg">{s.texto}</p>
                <a class="link" href={u(s.href)}>
                  {s.acao} <span class="arrow">→</span>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- DESTAQUES -->
  <section class="section destaques" aria-labelledby="destaques-titulo">
    <div class="wrap">
      <header class="sec-head sec-head--row" data-reveal>
        <div>
          <p class="eyebrow">Do acervo</p>
          <h2 id="destaques-titulo" class="h2">Peças em destaque</h2>
        </div>
        <a class="link" href={u('/acervo/')}>Ver as {pecas.length} peças <span class="arrow">→</span></a>
      </header>
      <div class="rail" data-reveal>
        {destaques.map((p) => <PecaCard peca={p} sizes="(max-width: 700px) 72vw, (max-width: 1100px) 33vw, 25vw" />)}
      </div>
    </div>
  </section>

  <!-- FEITAS PARA USAR -->
  <section class="usos section" aria-labelledby="usos-titulo">
    <div class="wrap usos-in">
      <header class="usos-head" data-reveal>
        <p class="eyebrow">À mesa</p>
        <h2 id="usos-titulo" class="h2">Feitas para a mesa de todo dia.</h2>
        <p class="body-lg">
          Porcelana pintada não precisa morar na cristaleira. As peças vão à mesa, recebem o queijo, a manteiga, o
          patê — e ficam ainda mais bonitas em uso.
        </p>
      </header>
      <div class="usos-grid">
        {
          usos.map((v, i) => (
            <a class="uso" href={u(`/acervo/${v.slug}/`)} data-reveal style={`--delay:${i * 0.08}s`}>
              <div class="uso-media frame">
                <video
                  data-loop
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={u(`/video/${v.video}.jpg`)}
                  aria-label={`Vídeo: ${v.nome} em uso`}
                >
                  <source src={u(`/video/${v.video}.mp4`)} type="video/mp4" />
                </video>
              </div>
              <p class="uso-name">
                {v.nome} <span class="arrow">→</span>
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HISTÓRIA -->
  <section class="historia" aria-labelledby="historia-titulo">
    <div class="wrap historia-in">
      <div class="historia-video" data-reveal>
        <div class="player frame" data-player>
          <video
            controls
            playsinline
            preload="none"
            poster={u('/video/historia-prato-shabat.jpg')}
            aria-label="Vídeo: a artista conta a história do Prato de Shabat"
          >
            <source src={u('/video/historia-prato-shabat.mp4')} type="video/mp4" />
          </video>
          <button class="player-btn" type="button" data-play>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
            <span>Assistir · 50s</span>
          </button>
        </div>
      </div>
      <div class="historia-text" data-reveal style="--delay:.1s">
        <p class="eyebrow">A história por trás da peça</p>
        <h2 id="historia-titulo" class="h2">Paz, Salam, Shalom.</h2>
        <p class="body-lg">
          O avô da artista era fluente em árabe, hebraico e português. Entre os desenhos que deixou, havia uma folha de
          papel com três palavras — <em>Paz</em>, <em>Salam</em> e <em>Shalom</em>.
        </p>
        <p class="body-lg">
          A folha virou um prato de Shabat, com flores pequeninas, e ganhou a companhia de um kos para o kidush das
          sextas-feiras.
        </p>
        <blockquote class="quote">
          <p>“Assim, o meu avô ficou eternizado em todos os jantares religiosos da família.”</p>
        </blockquote>
        <div class="historia-pecas">
          <a class="mini" href={u('/acervo/prato-de-shabat/')}>
            <span class="mini-img frame">
              <Image src={foto('prato-de-shabat', 1)} alt="" widths={[160, 240]} sizes="80px" />
            </span>
            <span>Prato de Shabat <span class="arrow">→</span></span>
          </a>
          <a class="mini" href={u('/acervo/taca-de-kidush/')}>
            <span class="mini-img frame">
              <Image src={foto('taca-de-kidush', 1)} alt="" widths={[160, 240]} sizes="80px" />
            </span>
            <span>Kos de Kidush <span class="arrow">→</span></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ARTISTA -->
  <section class="artista section" aria-labelledby="artista-titulo">
    <div class="wrap artista-in">
      <div class="artista-media frame pebble-2" data-reveal>
        <Image
          src={editorial('0Q2A5604')}
          alt={artista ? `${artista}, artista da Pitua, segurando uma de suas peças` : 'A artista da Pitua segurando uma de suas peças'}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 900px) 90vw, 40vw"
        />
      </div>
      <div class="artista-text" data-reveal style="--delay:.1s">
        <p class="eyebrow">A artista</p>
        <h2 id="artista-titulo" class="h2">Por trás de cada peça, as mesmas mãos.</h2>
        <p class="body-lg">
          {artista ? `Na Pitua, ${artista} conduz cada peça` : 'Na Pitua, cada peça passa pelas mesmas mãos'} — do primeiro
          desenho à última pincelada. Um trabalho paciente e detalhista, que mistura as cores do Brasil, padrões do mundo
          inteiro e muitas histórias de família.
        </p>
        <a class="link" href={linkWhatsapp('Olá! Vim pelo site da Pitua e queria conversar sobre uma peça.')} target="_blank" rel="noopener">
          Conversar com a artista <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ENCOMENDAS -->
  <section class="encomenda" aria-labelledby="encomenda-titulo">
    <div class="encomenda-media frame">
      <Image
        src={foto('cuba-baloes', 1)}
        alt="Cuba de lavabo pintada sob medida, com faixas de padrões e balões coloridos"
        widths={[720, 960, 1280, 1600]}
        sizes="(max-width: 900px) 100vw, 50vw"
      />
      <span class="hero-cap">Cuba Balões — projeto sob medida</span>
    </div>
    <div class="encomenda-text">
      <p class="eyebrow status" data-reveal>Encomendas abertas</p>
      <h2 id="encomenda-titulo" class="h2" data-reveal>Uma peça só sua.</h2>
      <p class="body-lg" data-reveal>
        Do aparelho de jantar à cuba do lavabo, do presente de casamento ao prato de Shabat da família: a peça é
        desenhada a partir da sua ideia e pintada exclusivamente para você.
      </p>
      <ol class="passos" data-reveal>
        <li><span>01</span> Conversa</li>
        <li><span>02</span> Desenho</li>
        <li><span>03</span> Pintura</li>
        <li><span>04</span> Entrega</li>
      </ol>
      <div data-reveal>
        <a class="btn" href={u('/encomendas/')}>Começar uma encomenda</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    min-height: calc(100svh - var(--header-h));
    max-height: 1100px;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.75rem;
    padding: 3rem clamp(1.5rem, 4vw, 4rem) 4rem max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
  }
  .hero-text .display em {
    display: block;
    font-weight: 300;
  }
  .hero-lede {
    max-width: 26em;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 0.5rem;
  }
  .hero-media {
    display: block;
    height: 100%;
    min-height: 520px;
  }
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    animation: hero-zoom 2.4s var(--ease) both;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
      opacity: 0;
    }
  }
  .hero-cap {
    position: absolute;
    right: 1.25rem;
    bottom: 1.1rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }

  /* MANIFESTO */
  .manifesto {
    text-align: center;
  }
  .manifesto-txt {
    max-width: 21em;
    margin-inline: auto;
    font-family: var(--serif);
    font-size: clamp(1.75rem, 3.3vw, 3.1rem);
    font-weight: 280;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .pilares {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem clamp(1.5rem, 4vw, 4rem);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pilares .serif {
    font-size: 1.1rem;
    letter-spacing: 0;
    text-transform: none;
    margin-right: 0.35rem;
    color: var(--ink);
  }

  /* SEÇÕES */
  .sec-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .sec-head--row {
    grid-template-columns: 1fr auto;
    align-items: end;
  }

  /* SERVIÇOS */
  .servicos {
    padding-bottom: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
    padding-top: clamp(5rem, 10vw, 9rem);
  }
  .srv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
  }
  .srv {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    gap: 2rem;
  }
  .srv-media {
    grid-column: 1 / span 5;
    aspect-ratio: 1 / 1.08;
    display: block;
  }
  .srv-media :global(img) {
    transition: transform 1.6s var(--ease);
  }
  .srv-media:hover :global(img) {
    transform: scale(1.04);
  }
  .srv-text {
    grid-column: 7 / span 5;
    display: grid;
    gap: 1.15rem;
    justify-items: start;
  }
  .srv--rev .srv-media {
    grid-column: 8 / span 5;
    grid-row: 1;
  }
  .srv--rev .srv-text {
    grid-column: 2 / span 5;
    grid-row: 1;
  }
  .srv-n {
    font-size: 4.5rem;
    font-weight: 300;
    line-height: 0.8;
    color: var(--gold);
    font-style: italic;
  }
  .srv-text .body-lg {
    max-width: 30em;
  }

  /* DESTAQUES */
  .destaques {
    padding-top: clamp(4rem, 8vw, 7rem);
  }
  .rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1rem, 2vw, 1.75rem);
  }

  /* USOS */
  .usos {
    background: var(--paper-2);
  }
  .usos-in {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .usos-head {
    display: grid;
    gap: 1.25rem;
  }
  .usos-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .uso {
    display: grid;
    gap: 0.9rem;
  }
  .uso-media {
    aspect-ratio: 9 / 16;
    border-radius: 999px 999px 0 0;
  }
  .uso-name {
    font-family: var(--serif);
    font-weight: 330;
    font-size: 1.15rem;
    line-height: 1.2;
  }
  .uso-name .arrow {
    display: inline-block;
    transition: transform 0.5s var(--ease);
  }
  .uso:hover .uso-name .arrow {
    transform: translateX(4px);
  }

  /* HISTÓRIA */
  .historia {
    background: var(--night);
    color: var(--on-night);
    padding-block: clamp(5rem, 10vw, 9rem);
  }
  .historia .eyebrow {
    color: var(--on-night-muted);
  }
  .historia .body-lg {
    color: color-mix(in srgb, var(--on-night) 82%, transparent);
  }
  .historia-in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }
  .historia-video {
    max-width: 440px;
    width: 100%;
    justify-self: end;
  }
  .player {
    aspect-ratio: 9 / 16;
    background: var(--night-2);
  }
  .player-btn {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.3rem 0.8rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 999px;
    background: rgb(23 21 19 / 0.35);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s;
  }
  .player-btn:hover {
    background: rgb(23 21 19 / 0.6);
  }
  .player-btn svg {
    width: 18px;
    height: 18px;
  }
  .player.is-playing .player-btn {
    display: none;
  }
  .historia-text {
    display: grid;
    gap: 1.4rem;
    max-width: 34rem;
  }
  .quote {
    margin: 0.5rem 0 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--gold);
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    font-weight: 300;
    line-height: 1.3;
  }
  .historia-pecas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 0.75rem;
  }
  .mini {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .mini-img {
    width: 64px;
    height: 80px;
    flex: none;
  }

  /* ARTISTA */
  .artista-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem;
    align-items: center;
  }
  .artista-media {
    grid-column: 2 / span 4;
    aspect-ratio: 4 / 5;
  }
  .artista-media :global(img) {
    object-position: 50% 30%;
  }
  .artista-text {
    grid-column: 7 / span 5;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  /* ENCOMENDA */
  .encomenda {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--paper-2);
  }
  .encomenda-media {
    min-height: 640px;
  }
  .encomenda-media :global(img) {
    position: absolute;
    inset: 0;
  }
  .encomenda-text {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.6rem;
    padding: clamp(3rem, 7vw, 7rem) max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))) clamp(3rem, 7vw, 7rem)
      clamp(2rem, 6vw, 6rem);
  }
  .encomenda-text .body-lg {
    max-width: 32em;
  }
  .passos {
    list-style: none;
    margin: 0.5rem 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 1rem 2rem;
    font-family: var(--serif);
    font-weight: 330;
    font-size: 1.25rem;
  }
  .passos li {
    display: grid;
    gap: 0.2rem;
  }
