<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((p) => {
    const video = p.querySelector('video')!;
    const btn = p.querySelector<HTMLButtonElement>('[data-play]');
    video.controls = false;
    btn?.addEventListener('click', () => {
      video.controls = true;
      video.play();
    });
    video.addEventListener('play', () => p.classList.add('is-playing'));
  });

  document.querySelectorAll<HTMLElement>('[data-carrossel]').forEach((track) => {
    const wrap = track.parentElement!;
    const itens = [...track.children] as HTMLElement[];
    const dots = [...wrap.querySelectorAll<HTMLElement>('.car-dots i')];
    const prev = wrap.querySelector<HTMLButtonElement>('[data-car-prev]');
    const next = wrap.querySelector<HTMLButtonElement>('[data-car-next]');
    const atual = () => {
      const centro = track.scrollLeft + track.clientWidth / 2;
      let melhor = 0;
      itens.forEach((el, i) => {
        if (Math.abs(el.offsetLeft + el.offsetWidth / 2 - centro) < Math.abs(itens[melhor].offsetLeft + itens[melhor].offsetWidth / 2 - centro)) melhor = i;
      });
      return melhor;
    };
    const ir = (i: number) => {
      const el = itens[Math.max(0, Math.min(itens.length - 1, i))];
      track.scrollTo({ left: el.offsetLeft - (track.clientWidth - el.offsetWidth) / 2, behavior: 'smooth' });
    };
    const marca = () => {
      const i = atual();
      dots.forEach((d, j) => d.classList.toggle('on', j === i));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === itens.length - 1;
    };
    prev?.addEventListener('click', () => ir(atual() - 1));
    next?.addEventListener('click', () => ir(atual() + 1));
    track.addEventListener('scroll', marca, { passive: true });
    marca();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-abre-video]').forEach((btn) => {
    const dlg = document.querySelector<HTMLDialogElement>(`dialog[data-video="${btn.dataset.abreVideo}"]`);
    const video = dlg?.querySelector('video');
    btn.addEventListener('click', () => {
      dlg?.showModal();
      video?.play().catch(() => {});
    });
    dlg?.addEventListener('close', () => video?.pause());
    dlg?.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg?.querySelector('[data-fecha-video]')?.addEventListener('click', () => dlg.close());
  });
</script>
